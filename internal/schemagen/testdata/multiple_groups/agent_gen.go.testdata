package acp

import (
	"context"
	"github.com/spachava753/acp-sdk/internal/jsonrpc2"
	"github.com/spachava753/acp-sdk/jsonrpc"
)

// DeltaWrite: Asks the client to write delta state.
func (c *AgentConnection) DeltaWrite(ctx context.Context, params *WriteDeltaRequest) (*WriteDeltaResponse, error) {
	return call[WriteDeltaResponse](ctx, c.rpc.conn, MethodDeltaWrite, params)
}

// GammaRead: Asks the client to read gamma state.
func (c *AgentConnection) GammaRead(ctx context.Context, params *ReadGammaRequest) (*ReadGammaResponse, error) {
	return call[ReadGammaResponse](ctx, c.rpc.conn, MethodGammaRead, params)
}

func handleAgentRequest(ctx context.Context, handler any, req *jsonrpc.Request) (any, error) {
	jsonrpc2.Async(ctx)
	switch req.Method {
	case MethodAlphaStart:
		h, ok := handler.(AlphaStartHandler)
		if !ok {
			return nil, methodNotFound(req.Method)
		}
		params, err := decodeParams[StartAlphaRequest](req)
		if err != nil {
			return nil, err
		}
		return rpcResult(h.AlphaStart(ctx, params))
	case MethodBetaStop:
		h, ok := handler.(BetaStopHandler)
		if !ok {
			return nil, methodNotFound(req.Method)
		}
		params, err := decodeParams[StopBetaRequest](req)
		if err != nil {
			return nil, err
		}
		return rpcResult(h.BetaStop(ctx, params))
	default:
		return handleExtension(ctx, handler, req)
	}
}
