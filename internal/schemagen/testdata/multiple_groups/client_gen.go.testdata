package acp

import (
	"context"
	"github.com/spachava753/acp-sdk/jsonrpc"
)

// AlphaStart: Asks the agent to start alpha processing.
func (c *Client) AlphaStart(ctx context.Context, params *StartAlphaRequest) (*StartAlphaResponse, error) {
	return call[StartAlphaResponse](ctx, c.rpc.conn, MethodAlphaStart, params)
}

// BetaStop: Asks the agent to stop beta processing.
func (c *Client) BetaStop(ctx context.Context, params *StopBetaRequest) (*StopBetaResponse, error) {
	return call[StopBetaResponse](ctx, c.rpc.conn, MethodBetaStop, params)
}

func handleClientRequest(ctx context.Context, handler any, req *jsonrpc.Request) (any, error) {
	beginHandler(ctx, req)
	switch req.Method {
	case MethodDeltaWrite:
		if !req.IsCall() {
			return nil, nil
		}
		h, ok := handler.(DeltaWriteHandler)
		if !ok {
			return nil, methodNotFound(req.Method)
		}
		params, err := decodeProtocolParams[WriteDeltaRequest](req)
		if err != nil {
			return nil, err
		}
		return rpcResult(h.DeltaWrite(ctx, params))
	case MethodGammaRead:
		if !req.IsCall() {
			return nil, nil
		}
		h, ok := handler.(GammaReadHandler)
		if !ok {
			return nil, methodNotFound(req.Method)
		}
		params, err := decodeProtocolParams[ReadGammaRequest](req)
		if err != nil {
			return nil, err
		}
		return rpcResult(h.GammaRead(ctx, params))
	default:
		return handleExtension(ctx, handler, req)
	}
}
