package acp

import (
	"encoding/json"
	"fmt"
)

// LinkWidget: Link widget branch.
type LinkWidget struct {
	Url string `json:"url"`
}

// UnmarshalJSON implements json.Unmarshaler.
func (w *LinkWidget) UnmarshalJSON(data []byte) error {
	if err := requireJSONProperties(data, []string{"url"}, []string{"url"}); err != nil {
		return err
	}
	type alias LinkWidget
	decoded := alias{}
	raw := struct {
		*alias
	}{alias: &decoded}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	*w = LinkWidget(decoded)
	return nil
}

// TextKind: Text widget kind.
type TextKind string

const (
	// TextKindText: Text kind.
	TextKindText TextKind = "text"
)

// UnmarshalJSON rejects values outside the closed schema enum.
func (v *TextKind) UnmarshalJSON(data []byte) error {
	var value string
	if isJSONNull(data) {
		return fmt.Errorf("TextKind must not be null")
	}
	if err := unmarshalJSON(data, &value); err != nil {
		return err
	}
	switch value {
	case "text":
		*v = TextKind(value)
		return nil
	}
	return fmt.Errorf("invalid TextKind value %q", value)
}

// TextWidget: Text widget branch.
type TextWidget struct {
	Kind  TextKind `json:"kind"`
	Label string   `json:"label"`
}

// UnmarshalJSON implements json.Unmarshaler.
func (w *TextWidget) UnmarshalJSON(data []byte) error {
	if err := requireJSONProperties(data, []string{"kind", "label"}, []string{"kind", "label"}); err != nil {
		return err
	}
	type alias TextWidget
	decoded := alias{}
	raw := struct {
		*alias
	}{alias: &decoded}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	*w = TextWidget(decoded)
	return nil
}

// Widget: Union with a branch-required const field.
type Widget struct {
	Kind  TextKind `json:"kind,omitempty"`
	Label *string  `json:"label,omitempty"`
	Url   *string  `json:"url,omitempty"`
}

// NewTextWidget creates an Widget variant: Text branch.
func NewTextWidget(label string) Widget {
	return Widget{
		Kind:  TextKindText,
		Label: &label,
	}
}

// NewLinkWidget creates an Widget variant: Link branch.
func NewLinkWidget(url string) Widget {
	return Widget{
		Url: &url,
	}
}

// UnmarshalJSON decodes the first valid schema alternative.
func (w *Widget) UnmarshalJSON(data []byte) error {
	type alias Widget
	var decoded alias
	var raw struct {
		Kind  json.RawMessage `json:"kind"`
		Label json.RawMessage `json:"label"`
		Url   json.RawMessage `json:"url"`
	}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	var err error
	err = func() error {
		decoded = alias{}
		if err := requireJSONProperties(data, []string{"kind", "label"}, []string{"kind", "label"}); err != nil {
			return err
		}
		if len(raw.Kind) > 0 {
			var value TextKind
			if err := unmarshalJSON(raw.Kind, &value); err != nil {
				return err
			}
			decoded.Kind = value
		}
		if len(raw.Label) > 0 {
			var value string
			if err := unmarshalJSON(raw.Label, &value); err != nil {
				return err
			}
			decoded.Label = func(v string) *string {
				converted := string(v)
				return &converted
			}(value)
		}
		return nil
	}()
	if err == nil {
		*w = Widget(decoded)
		return nil
	}
	err = func() error {
		decoded = alias{}
		if err := requireJSONProperties(data, []string{"url"}, []string{"url"}); err != nil {
			return err
		}
		if len(raw.Url) > 0 {
			var value string
			if err := unmarshalJSON(raw.Url, &value); err != nil {
				return err
			}
			decoded.Url = func(v string) *string {
				converted := string(v)
				return &converted
			}(value)
		}
		return nil
	}()
	if err == nil {
		*w = Widget(decoded)
		return nil
	}
	return err
}
