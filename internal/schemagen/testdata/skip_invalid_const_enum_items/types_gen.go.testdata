package acp

import (
	"encoding/json"
	"fmt"
)

// Encoding: Known encodings.
type Encoding string

const (
	// EncodingUtf8: UTF-8 encoding.
	EncodingUtf8 Encoding = "utf-8"
	// EncodingUtf16: UTF-16 encoding.
	EncodingUtf16 Encoding = "utf-16"
)

// UnmarshalJSON rejects values outside the closed schema enum.
func (v *Encoding) UnmarshalJSON(data []byte) error {
	var value string
	if isJSONNull(data) {
		return fmt.Errorf("Encoding must not be null")
	}
	if err := unmarshalJSON(data, &value); err != nil {
		return err
	}
	switch value {
	case "utf-8", "utf-16":
		*v = Encoding(value)
		return nil
	}
	return fmt.Errorf("invalid Encoding value %q", value)
}

// Payload: Object with tolerant arrays of const enum items.
type Payload struct {
	Encodings []Encoding `json:"encodings,omitempty"`
}

// UnmarshalJSON implements json.Unmarshaler.
func (p *Payload) UnmarshalJSON(data []byte) error {
	type alias Payload
	decoded := alias{}
	raw := struct {
		Encodings json.RawMessage `json:"encodings"`
		*alias
	}{alias: &decoded}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	if len(raw.Encodings) > 0 {
		var values []json.RawMessage
		if err := unmarshalJSON(raw.Encodings, &values); err == nil {
			decoded.Encodings = []Encoding{}
			for _, value := range values {
				var item Encoding
				if err := unmarshalJSON(value, &item); err == nil && !isJSONNull(value) {
					switch item {
					case EncodingUtf8, EncodingUtf16:
						decoded.Encodings = append(decoded.Encodings, item)
					}
				}
			}
		}
	}
	*p = Payload(decoded)
	return nil
}
