package acp

import (
	"encoding/json"
	"fmt"
	"reflect"
)

// TextPayload: Message payload.
type TextPayload struct {
	Text string `json:"text"`
}

// UnmarshalJSON implements json.Unmarshaler.
func (p *TextPayload) UnmarshalJSON(data []byte) error {
	if err := requireJSONProperties(data, []string{"text"}, []string{"text"}); err != nil {
		return err
	}
	type alias TextPayload
	decoded := alias{}
	raw := struct {
		*alias
	}{alias: &decoded}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	*p = TextPayload(decoded)
	return nil
}

// ToolContent: Tool content item.
type ToolContent struct {
	Type       ToolContentType `json:"type"`
	TerminalID string          `json:"terminalId,omitempty"`
	Text       string          `json:"text,omitempty"`
}

// ToolContentType is the discriminator for ToolContent variants.
type ToolContentType string

const (
	ToolContentTypeText     ToolContentType = "text"
	ToolContentTypeTerminal ToolContentType = "terminal"
)

// TextToolContent creates text item.
func TextToolContent(text string) ToolContent {
	return ToolContent{
		Type: ToolContentTypeText,
		Text: text,
	}
}

// TerminalToolContent creates terminal item.
func TerminalToolContent(terminalID string) ToolContent {
	return ToolContent{
		Type:       ToolContentTypeTerminal,
		TerminalID: terminalID,
	}
}

// MarshalJSON implements json.Marshaler.
func (c ToolContent) MarshalJSON() ([]byte, error) {
	type alias ToolContent
	type wire struct {
		*alias
		Text       *string `json:"text,omitempty"`
		TerminalID *string `json:"terminalId,omitempty"`
	}
	w := wire{alias: (*alias)(&c)}
	if !reflect.ValueOf(c.Text).IsZero() {
		Text := c.Text
		w.Text = &Text
	}
	if !reflect.ValueOf(c.TerminalID).IsZero() {
		TerminalID := c.TerminalID
		w.TerminalID = &TerminalID
	}
	switch c.Type {
	case ToolContentTypeText:
		Text := c.Text
		w.Text = &Text
	case ToolContentTypeTerminal:
		TerminalID := c.TerminalID
		w.TerminalID = &TerminalID
	}
	return json.Marshal(w)
}

// UnmarshalJSON decodes the selected schema variant.
func (c *ToolContent) UnmarshalJSON(data []byte) error {
	type alias ToolContent
	var decoded alias
	var raw struct {
		Type       json.RawMessage `json:"type"`
		TerminalID json.RawMessage `json:"terminalId"`
		Text       json.RawMessage `json:"text"`
	}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	var tag ToolContentType
	var tagErr error
	if len(raw.Type) > 0 {
		tagErr = unmarshalJSON(raw.Type, &tag)
	}
	var err error
	switch tag {
	case "text":
		err = func() error {
			decoded = alias{}
			if tagErr != nil {
				return tagErr
			}
			decoded.Type = tag
			if err := requireJSONProperties(data, []string{"type", "text"}, []string{"text", "type"}); err != nil {
				return err
			}
			if len(raw.Text) > 0 {
				var value string
				if err := unmarshalJSON(raw.Text, &value); err != nil {
					return err
				}
				decoded.Text = value
			}
			return nil
		}()
	case "terminal":
		err = func() error {
			decoded = alias{}
			if tagErr != nil {
				return tagErr
			}
			decoded.Type = tag
			if err := requireJSONProperties(data, []string{"type", "terminalId"}, []string{"terminalId", "type"}); err != nil {
				return err
			}
			if len(raw.TerminalID) > 0 {
				var value string
				if err := unmarshalJSON(raw.TerminalID, &value); err != nil {
					return err
				}
				decoded.TerminalID = value
			}
			return nil
		}()
	default:
		return fmt.Errorf("ToolContent: unknown type %q", tag)
	}
	if err != nil {
		return err
	}
	*c = ToolContent(decoded)
	return nil
}

// Update: Update union with a shared field that merges to any.
type Update struct {
	Kind    UpdateType `json:"kind"`
	Payload any        `json:"payload,omitempty,omitzero"`
}

// UpdateType is the discriminator for Update variants.
type UpdateType string

const (
	UpdateTypeMessage UpdateType = "message"
	UpdateTypeTool    UpdateType = "tool"
)

// MessageUpdate creates message update with an object payload.
func MessageUpdate(payload TextPayload) Update {
	return Update{
		Kind:    UpdateTypeMessage,
		Payload: payload,
	}
}

// ToolUpdate creates tool update with tolerant array payload.
func ToolUpdate() Update {
	return Update{
		Kind: UpdateTypeTool,
	}
}

// MarshalJSON implements json.Marshaler.
func (u Update) MarshalJSON() ([]byte, error) {
	type alias Update
	type wire struct {
		*alias
		Payload *any `json:"payload,omitempty"`
	}
	w := wire{alias: (*alias)(&u)}
	if u.Payload != nil {
		Payload := u.Payload
		w.Payload = &Payload
	}
	switch u.Kind {
	case UpdateTypeMessage:
		Payload := u.Payload
		w.Payload = &Payload
	}
	return json.Marshal(w)
}

// UnmarshalJSON decodes the selected schema variant.
func (u *Update) UnmarshalJSON(data []byte) error {
	type alias Update
	var decoded alias
	var raw struct {
		Kind    json.RawMessage `json:"kind"`
		Payload json.RawMessage `json:"payload"`
	}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	var tag UpdateType
	var tagErr error
	if len(raw.Kind) > 0 {
		tagErr = unmarshalJSON(raw.Kind, &tag)
	}
	var err error
	switch tag {
	case "message":
		err = func() error {
			decoded = alias{}
			if tagErr != nil {
				return tagErr
			}
			decoded.Kind = tag
			if err := requireJSONProperties(data, []string{"kind", "payload"}, []string{"kind", "payload"}); err != nil {
				return err
			}
			if len(raw.Payload) > 0 {
				var value TextPayload
				if err := unmarshalJSON(raw.Payload, &value); err != nil {
					return err
				}
				decoded.Payload = value
			}
			return nil
		}()
	case "tool":
		err = func() error {
			decoded = alias{}
			if tagErr != nil {
				return tagErr
			}
			decoded.Kind = tag
			if err := requireJSONProperties(data, []string{"kind"}, []string{"kind"}); err != nil {
				return err
			}
			if len(raw.Payload) > 0 {
				var values []json.RawMessage
				if err := unmarshalJSON(raw.Payload, &values); err == nil {
					items := []ToolContent{}
					for _, rawItem := range values {
						var item ToolContent
						if err := unmarshalJSON(rawItem, &item); err == nil {
							switch item.Type {
							case ToolContentTypeText, ToolContentTypeTerminal:
								items = append(items, item)
							}
						}
					}
					decoded.Payload = items
				}
			}
			return nil
		}()
	default:
		return fmt.Errorf("Update: unknown kind %q", tag)
	}
	if err != nil {
		return err
	}
	*u = Update(decoded)
	return nil
}
