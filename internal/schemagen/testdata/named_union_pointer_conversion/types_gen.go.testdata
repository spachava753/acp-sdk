package acp

import (
	"encoding/json"
	"fmt"
)

// FixedStatus: Single status used by a constant-valued variant.
type FixedStatus string

const (
	FixedStatusFixed FixedStatus = "fixed"
)

// UnmarshalJSON rejects values outside the closed schema enum.
func (v *FixedStatus) UnmarshalJSON(data []byte) error {
	var value string
	if isJSONNull(data) {
		return fmt.Errorf("FixedStatus must not be null")
	}
	if err := unmarshalJSON(data, &value); err != nil {
		return err
	}
	switch value {
	case "fixed":
		*v = FixedStatus(value)
		return nil
	}
	return fmt.Errorf("invalid FixedStatus value %q", value)
}

// PrimaryStatus: Status used by the first update variant.
type PrimaryStatus string

const (
	PrimaryStatusRunning PrimaryStatus = "running"
)

// UnmarshalJSON rejects values outside the closed schema enum.
func (v *PrimaryStatus) UnmarshalJSON(data []byte) error {
	var value string
	if isJSONNull(data) {
		return fmt.Errorf("PrimaryStatus must not be null")
	}
	if err := unmarshalJSON(data, &value); err != nil {
		return err
	}
	switch value {
	case "running":
		*v = PrimaryStatus(value)
		return nil
	}
	return fmt.Errorf("invalid PrimaryStatus value %q", value)
}

// SecondaryStatus: Status used by the second update variant.
type SecondaryStatus string

const (
	SecondaryStatusCompleted SecondaryStatus = "completed"
	SecondaryStatusFailed    SecondaryStatus = "failed"
)

// Update: Flattened union with distinct named status types.
type Update struct {
	Kind   UpdateType     `json:"kind"`
	Status *PrimaryStatus `json:"status,omitempty"`
}

// UpdateType is the discriminator for Update variants.
type UpdateType string

const (
	UpdateTypePrimary           UpdateType = "primary"
	UpdateTypeSecondary         UpdateType = "secondary"
	UpdateTypeNullableSecondary UpdateType = "nullable_secondary"
	UpdateTypeFixed             UpdateType = "fixed"
)

// PrimaryUpdate creates update with a nullable primary status.
func PrimaryUpdate() Update {
	return Update{
		Kind: UpdateTypePrimary,
	}
}

// SecondaryUpdate creates update with a required secondary status.
func SecondaryUpdate(status SecondaryStatus) Update {
	return Update{
		Kind: UpdateTypeSecondary,
		Status: func(v SecondaryStatus) *PrimaryStatus {
			converted := PrimaryStatus(v)
			return &converted
		}(status),
	}
}

// NullableSecondaryUpdate creates update with a required nullable secondary status.
func NullableSecondaryUpdate(status *SecondaryStatus) Update {
	return Update{
		Kind: UpdateTypeNullableSecondary,
		Status: func(v *SecondaryStatus) *PrimaryStatus {
			if v == nil {
				return nil
			}
			converted := PrimaryStatus(*v)
			return &converted
		}(status),
	}
}

// FixedUpdate creates update with a constant status.
func FixedUpdate() Update {
	return Update{
		Kind: UpdateTypeFixed,
		Status: func(v FixedStatus) *PrimaryStatus {
			converted := PrimaryStatus(v)
			return &converted
		}(FixedStatusFixed),
	}
}

// MarshalJSON implements json.Marshaler.
func (u Update) MarshalJSON() ([]byte, error) {
	type alias Update
	type wire struct {
		*alias
		Status **PrimaryStatus `json:"status,omitempty"`
	}
	w := wire{alias: (*alias)(&u)}
	if u.Status != nil {
		Status := u.Status
		w.Status = &Status
	}
	switch u.Kind {
	case UpdateTypeSecondary:
		Status := u.Status
		w.Status = &Status
	case UpdateTypeNullableSecondary:
		Status := u.Status
		w.Status = &Status
	case UpdateTypeFixed:
		Status := u.Status
		w.Status = &Status
	}
	return json.Marshal(w)
}

// UnmarshalJSON decodes the selected schema variant.
func (u *Update) UnmarshalJSON(data []byte) error {
	type alias Update
	var decoded alias
	var raw struct {
		Kind   json.RawMessage `json:"kind"`
		Status json.RawMessage `json:"status"`
	}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	var tag UpdateType
	var tagErr error
	if len(raw.Kind) > 0 {
		tagErr = unmarshalJSON(raw.Kind, &tag)
	}
	var err error
	switch tag {
	case "primary":
		err = func() error {
			decoded = alias{}
			if tagErr != nil {
				return tagErr
			}
			decoded.Kind = tag
			if err := requireJSONProperties(data, []string{"kind"}, []string{"kind"}); err != nil {
				return err
			}
			if len(raw.Status) > 0 {
				var value PrimaryStatus
				if err := unmarshalJSON(raw.Status, &value); err == nil {
					switch string(value) {
					case "running":
						decoded.Status = &value
					}
				}
			}
			return nil
		}()
	case "secondary":
		err = func() error {
			decoded = alias{}
			if tagErr != nil {
				return tagErr
			}
			decoded.Kind = tag
			if err := requireJSONProperties(data, []string{"kind", "status"}, []string{"kind", "status"}); err != nil {
				return err
			}
			if len(raw.Status) > 0 {
				var value SecondaryStatus
				if err := unmarshalJSON(raw.Status, &value); err != nil {
					return err
				}
				decoded.Status = func(v SecondaryStatus) *PrimaryStatus {
					converted := PrimaryStatus(v)
					return &converted
				}(value)
			}
			return nil
		}()
	case "nullable_secondary":
		err = func() error {
			decoded = alias{}
			if tagErr != nil {
				return tagErr
			}
			decoded.Kind = tag
			if err := requireJSONProperties(data, []string{"kind", "status"}, []string{"kind"}); err != nil {
				return err
			}
			if len(raw.Status) > 0 {
				var value *SecondaryStatus
				if err := unmarshalJSON(raw.Status, &value); err != nil {
					return err
				}
				decoded.Status = func(v *SecondaryStatus) *PrimaryStatus {
					if v == nil {
						return nil
					}
					converted := PrimaryStatus(*v)
					return &converted
				}(value)
			}
			return nil
		}()
	case "fixed":
		err = func() error {
			decoded = alias{}
			if tagErr != nil {
				return tagErr
			}
			decoded.Kind = tag
			if err := requireJSONProperties(data, []string{"kind", "status"}, []string{"kind", "status"}); err != nil {
				return err
			}
			if len(raw.Status) > 0 {
				var value FixedStatus
				if err := unmarshalJSON(raw.Status, &value); err != nil {
					return err
				}
				decoded.Status = func(v FixedStatus) *PrimaryStatus {
					converted := PrimaryStatus(v)
					return &converted
				}(value)
			}
			return nil
		}()
	default:
		return fmt.Errorf("Update: unknown kind %q", tag)
	}
	if err != nil {
		return err
	}
	*u = Update(decoded)
	return nil
}
