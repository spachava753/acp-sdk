package acp

import (
	"encoding/json"
	"fmt"
	"reflect"
)

// AnnotationSet: Object with nullable arrays that skip invalid entries.
type AnnotationSet struct {
	Audience *[]Role   `json:"audience,omitempty"`
	Labels   *[]string `json:"labels,omitempty"`
	Strict   string    `json:"strict"`
}

// UnmarshalJSON implements json.Unmarshaler.
func (s *AnnotationSet) UnmarshalJSON(data []byte) error {
	if err := requireJSONProperties(data, []string{"strict"}, []string{"strict"}); err != nil {
		return err
	}
	type alias AnnotationSet
	decoded := alias{}
	raw := struct {
		Audience json.RawMessage `json:"audience"`
		Labels   json.RawMessage `json:"labels"`
		*alias
	}{alias: &decoded}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	if len(raw.Audience) > 0 {
		var values []json.RawMessage
		if err := unmarshalJSON(raw.Audience, &values); err == nil && values != nil {
			items := []Role{}
			for _, value := range values {
				var item Role
				if err := unmarshalJSON(value, &item); err == nil {
					switch item {
					case "assistant", "user":
						items = append(items, item)
					}
				}
			}
			decoded.Audience = &items
		}
	}
	if len(raw.Labels) > 0 {
		var values []json.RawMessage
		if err := unmarshalJSON(raw.Labels, &values); err == nil && values != nil {
			items := []string{}
			for _, value := range values {
				var item string
				if err := unmarshalJSON(value, &item); err == nil {
					items = append(items, item)
				}
			}
			decoded.Labels = &items
		}
	}
	*s = AnnotationSet(decoded)
	return nil
}

// Role: The sender or recipient of messages and data.
type Role string

const (
	RoleAssistant Role = "assistant"
	RoleUser      Role = "user"
)

// UnmarshalJSON rejects values outside the closed schema enum.
func (v *Role) UnmarshalJSON(data []byte) error {
	var value string
	if isJSONNull(data) {
		return fmt.Errorf("Role must not be null")
	}
	if err := unmarshalJSON(data, &value); err != nil {
		return err
	}
	switch value {
	case "assistant", "user":
		*v = Role(value)
		return nil
	}
	return fmt.Errorf("invalid Role value %q", value)
}

// TaggedAnnotation: Flattened union with a nullable array that skips invalid entries.
type TaggedAnnotation struct {
	Kind     TaggedAnnotationType `json:"kind"`
	Audience *[]Role              `json:"audience,omitempty"`
	Title    string               `json:"title,omitempty"`
}

// TaggedAnnotationType is the discriminator for TaggedAnnotation variants.
type TaggedAnnotationType string

const (
	TaggedAnnotationTypeKnown TaggedAnnotationType = "known"
	TaggedAnnotationTypeOther TaggedAnnotationType = "other"
)

// KnownTaggedAnnotation creates known branch.
func KnownTaggedAnnotation() TaggedAnnotation {
	return TaggedAnnotation{
		Kind: TaggedAnnotationTypeKnown,
	}
}

// OtherTaggedAnnotation creates other branch.
func OtherTaggedAnnotation(title string) TaggedAnnotation {
	return TaggedAnnotation{
		Kind:  TaggedAnnotationTypeOther,
		Title: title,
	}
}

// MarshalJSON implements json.Marshaler.
func (a TaggedAnnotation) MarshalJSON() ([]byte, error) {
	type alias TaggedAnnotation
	type wire struct {
		*alias
		Title *string `json:"title,omitempty"`
	}
	w := wire{alias: (*alias)(&a)}
	if !reflect.ValueOf(a.Title).IsZero() {
		Title := a.Title
		w.Title = &Title
	}
	switch a.Kind {
	case TaggedAnnotationTypeOther:
		Title := a.Title
		w.Title = &Title
	}
	return json.Marshal(w)
}

// UnmarshalJSON decodes the selected schema variant.
func (a *TaggedAnnotation) UnmarshalJSON(data []byte) error {
	type alias TaggedAnnotation
	var decoded alias
	var raw struct {
		Kind     json.RawMessage `json:"kind"`
		Audience json.RawMessage `json:"audience"`
		Title    json.RawMessage `json:"title"`
	}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	var tag TaggedAnnotationType
	var tagErr error
	if len(raw.Kind) > 0 {
		tagErr = unmarshalJSON(raw.Kind, &tag)
	}
	var err error
	switch tag {
	case "known":
		err = func() error {
			decoded = alias{}
			if tagErr != nil {
				return tagErr
			}
			decoded.Kind = tag
			if err := requireJSONProperties(data, []string{"kind"}, []string{"kind"}); err != nil {
				return err
			}
			if len(raw.Audience) > 0 {
				var values []json.RawMessage
				if err := unmarshalJSON(raw.Audience, &values); err == nil && values != nil {
					items := []Role{}
					for _, rawItem := range values {
						var item Role
						if err := unmarshalJSON(rawItem, &item); err == nil {
							switch item {
							case "assistant", "user":
								items = append(items, item)
							}
						}
					}
					decoded.Audience = &items
				}
			}
			return nil
		}()
	case "other":
		err = func() error {
			decoded = alias{}
			if tagErr != nil {
				return tagErr
			}
			decoded.Kind = tag
			if err := requireJSONProperties(data, []string{"kind", "title"}, []string{"kind", "title"}); err != nil {
				return err
			}
			if len(raw.Title) > 0 {
				var value string
				if err := unmarshalJSON(raw.Title, &value); err != nil {
					return err
				}
				decoded.Title = value
			}
			return nil
		}()
	default:
		return fmt.Errorf("TaggedAnnotation: unknown kind %q", tag)
	}
	if err != nil {
		return err
	}
	*a = TaggedAnnotation(decoded)
	return nil
}
