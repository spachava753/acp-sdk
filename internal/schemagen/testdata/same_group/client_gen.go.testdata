package acp

import (
	"context"
	"github.com/spachava753/acp-sdk/internal/jsonrpc2"
	"github.com/spachava753/acp-sdk/jsonrpc"
)

// TaskStart: Asks the agent to start a task.
func (c *Client) TaskStart(ctx context.Context, params *StartTaskRequest) (*StartTaskResponse, error) {
	return call[StartTaskResponse](ctx, c.rpc.conn, MethodTaskStart, params)
}

// TaskStop: Asks the agent to stop a task.
func (c *Client) TaskStop(ctx context.Context, params *StopTaskRequest) (*StopTaskResponse, error) {
	return call[StopTaskResponse](ctx, c.rpc.conn, MethodTaskStop, params)
}

func handleClientRequest(ctx context.Context, handler any, req *jsonrpc.Request) (any, error) {
	jsonrpc2.Async(ctx)
	switch req.Method {
	case MethodTaskRead:
		h, ok := handler.(TaskReadHandler)
		if !ok {
			return nil, methodNotFound(req.Method)
		}
		params, err := decodeParams[ReadTaskRequest](req)
		if err != nil {
			return nil, err
		}
		return rpcResult(h.TaskRead(ctx, params))
	case MethodTaskWrite:
		h, ok := handler.(TaskWriteHandler)
		if !ok {
			return nil, methodNotFound(req.Method)
		}
		params, err := decodeParams[WriteTaskRequest](req)
		if err != nil {
			return nil, err
		}
		return rpcResult(h.TaskWrite(ctx, params))
	default:
		return handleExtension(ctx, handler, req)
	}
}
