package acp

import (
	"context"
	"github.com/spachava753/acp-sdk/internal/jsonrpc2"
	"github.com/spachava753/acp-sdk/jsonrpc"
)

// TaskRead: Asks the client to read task details.
func (c *AgentConnection) TaskRead(ctx context.Context, params *ReadTaskRequest) (*ReadTaskResponse, error) {
	return call[ReadTaskResponse](ctx, c.rpc.conn, MethodTaskRead, params)
}

// TaskWrite: Asks the client to write task details.
func (c *AgentConnection) TaskWrite(ctx context.Context, params *WriteTaskRequest) (*WriteTaskResponse, error) {
	return call[WriteTaskResponse](ctx, c.rpc.conn, MethodTaskWrite, params)
}

func handleAgentRequest(ctx context.Context, handler any, req *jsonrpc.Request) (any, error) {
	jsonrpc2.Async(ctx)
	switch req.Method {
	case MethodTaskStart:
		h, ok := handler.(TaskStartHandler)
		if !ok {
			return nil, methodNotFound(req.Method)
		}
		params, err := decodeParams[StartTaskRequest](req)
		if err != nil {
			return nil, err
		}
		return rpcResult(h.TaskStart(ctx, params))
	case MethodTaskStop:
		h, ok := handler.(TaskStopHandler)
		if !ok {
			return nil, methodNotFound(req.Method)
		}
		params, err := decodeParams[StopTaskRequest](req)
		if err != nil {
			return nil, err
		}
		return rpcResult(h.TaskStop(ctx, params))
	default:
		return handleExtension(ctx, handler, req)
	}
}
