// CollisionUnion: A discriminator union whose JSON fields normalize to duplicate Go names.
type CollisionUnion struct {
	Kind    CollisionUnionType `json:"kind"`
	FooBar  string             `json:"foo-bar,omitempty"`
	FooBar2 int32              `json:"foo_bar,omitempty"`
	Kind2   string             `json:"kind_,omitempty"`
