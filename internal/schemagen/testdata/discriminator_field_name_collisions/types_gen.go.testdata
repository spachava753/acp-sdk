// CollisionUnionType is the discriminator for CollisionUnion variants.
type CollisionUnionType string

const (
	CollisionUnionTypePair  CollisionUnionType = "pair"
	CollisionUnionTypeAlias CollisionUnionType = "alias"
)

// PairCollisionUnion creates variant with two colliding payload fields.
func PairCollisionUnion(fooBar string, fooBar2 int32) CollisionUnion {
	return CollisionUnion{
		Kind:    CollisionUnionTypePair,
		FooBar:  fooBar,
		FooBar2: fooBar2,
	}
}

// AliasCollisionUnion creates variant whose payload field collides with the discriminator field.
func AliasCollisionUnion(kind string) CollisionUnion {
	return CollisionUnion{
		Kind:  CollisionUnionTypeAlias,
		Kind2: kind,
	}
}

