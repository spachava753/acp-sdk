type RawId = json.RawMessage

type Request struct {
	// requiredFields retains selected nested scalar fields even when they are zero.
	requiredFields []string
	Mode           RequestType `json:"mode"`
	Message        string      `json:"message"`
	RequestID      RawId       `json:"requestId,omitempty"`
	SessionID      string      `json:"sessionId,omitempty"`
	ToolCallID     string      `json:"toolCallId,omitempty"`
	// ExtraFields retains extension properties explicitly permitted by the schema.
	// Known properties take precedence when encoding.
	ExtraFields map[string]json.RawMessage `json:"-"`
}

// RequestType is the discriminator for Request variants.
type RequestType string

const (
	RequestTypeKnown RequestType = "known"
)

// KnownRequest creates an Request variant:
func KnownRequest(message string) Request {
	return Request{
		Mode:    RequestTypeKnown,
		Message: message,
	}
}

// OtherRequest creates an Request variant:
func OtherRequest(mode string, message string) Request {
	return Request{
		Message: message,
		Mode:    RequestType(mode),
	}
}

// MarshalJSON implements json.Marshaler.
func (r Request) MarshalJSON() ([]byte, error) {
	type alias Request
	type wire struct {
		*alias
		SessionID *string `json:"sessionId,omitempty"`
	}
	w := wire{alias: (*alias)(&r)}
	if !reflect.ValueOf(r.SessionID).IsZero() {
		SessionID := r.SessionID
		w.SessionID = &SessionID
	}
	if slices.Contains(r.requiredFields, "sessionId") {
		SessionID := r.SessionID
		w.SessionID = &SessionID
	}
	switch r.Mode {
	}
	switch r.Mode {
	case "known":
		return json.Marshal(w)
	default:
		return marshalJSONWithExtraFields(w, r.ExtraFields, []string{"message", "mode", "requestId", "sessionId", "toolCallId"})
	}
}

