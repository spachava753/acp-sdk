type ScopeChoice struct {
	RequestID  *RawId  `json:"requestId,omitempty"`
	SessionID  *string `json:"sessionId,omitempty"`
	ToolCallID string  `json:"toolCallId,omitempty"`
}

// SessionScopeChoice creates an ScopeChoice variant:
func SessionScopeChoice(sessionID string) ScopeChoice {
	return ScopeChoice{
		SessionID: &sessionID,
	}
}

// RequestScopeChoice creates an ScopeChoice variant:
func RequestScopeChoice(requestID RawId) ScopeChoice {
	return ScopeChoice{
		RequestID: &requestID,
	}
}

// MarshalJSON emits the first present carrier in schema order.
func (c ScopeChoice) MarshalJSON() ([]byte, error) {
	if c.SessionID != nil {
		return json.Marshal(struct {
			SessionID  *string `json:"sessionId"`
			ToolCallID string  `json:"toolCallId,omitempty"`
		}{c.SessionID, c.ToolCallID})
	}
	if c.RequestID != nil {
		return json.Marshal(struct {
			RequestID *RawId `json:"requestId"`
		}{c.RequestID})
	}
	return nil, fmt.Errorf("ScopeChoice requires one of: sessionId, requestId")
}

