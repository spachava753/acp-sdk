type Body struct {
	Message    string  `json:"message"`
	RequestID  *RawId  `json:"requestId,omitempty"`
	SessionID  *string `json:"sessionId,omitempty"`
	ToolCallID string  `json:"toolCallId,omitempty"`
}

// SessionBody creates an Body variant:
func SessionBody(message string, sessionID string) Body {
	return Body{
		Message:   message,
		SessionID: &sessionID,
	}
}

// RequestBody creates an Body variant:
func RequestBody(message string, requestID RawId) Body {
	return Body{
		Message:   message,
		RequestID: &requestID,
	}
}

