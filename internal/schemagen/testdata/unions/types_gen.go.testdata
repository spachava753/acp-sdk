package acp

import (
	"encoding/json"
	"fmt"
	"reflect"
)

// ContentBlock: A flattened union of content block variants.
type ContentBlock struct {
	Type     ContentBlockType `json:"type"`
	Data     string           `json:"data,omitempty"`
	MimeType string           `json:"mimeType,omitempty"`
	Text     string           `json:"text,omitempty"`
	Title    string           `json:"title,omitempty"`
	URI      string           `json:"uri,omitempty"`
}

// ContentBlockType is the discriminator for ContentBlock variants.
type ContentBlockType string

const (
	// ContentBlockTypeText: Text content discriminator.
	ContentBlockTypeText ContentBlockType = "text"
	// ContentBlockTypeImage: Image content discriminator.
	ContentBlockTypeImage ContentBlockType = "image"
	// ContentBlockTypeResource: Resource content discriminator.
	ContentBlockTypeResource ContentBlockType = "resource"
)

// TextContentBlock creates text content displayed to the user.
func TextContentBlock(text string) ContentBlock {
	return ContentBlock{
		Type: ContentBlockTypeText,
		Text: text,
	}
}

// ImageContentBlock creates image content displayed to the user.
func ImageContentBlock(data string, mimeType string) ContentBlock {
	return ContentBlock{
		Type:     ContentBlockTypeImage,
		Data:     data,
		MimeType: mimeType,
	}
}

// ResourceContentBlock creates resource content displayed to the user.
func ResourceContentBlock(uri string) ContentBlock {
	return ContentBlock{
		Type: ContentBlockTypeResource,
		URI:  uri,
	}
}

// MarshalJSON implements json.Marshaler.
func (b ContentBlock) MarshalJSON() ([]byte, error) {
	type alias ContentBlock
	type wire struct {
		*alias
		Text     *string `json:"text,omitempty"`
		Data     *string `json:"data,omitempty"`
		MimeType *string `json:"mimeType,omitempty"`
		URI      *string `json:"uri,omitempty"`
	}
	w := wire{alias: (*alias)(&b)}
	if !reflect.ValueOf(b.Text).IsZero() {
		Text := b.Text
		w.Text = &Text
	}
	if !reflect.ValueOf(b.Data).IsZero() {
		Data := b.Data
		w.Data = &Data
	}
	if !reflect.ValueOf(b.MimeType).IsZero() {
		MimeType := b.MimeType
		w.MimeType = &MimeType
	}
	if !reflect.ValueOf(b.URI).IsZero() {
		URI := b.URI
		w.URI = &URI
	}
	switch b.Type {
	case ContentBlockTypeText:
		Text := b.Text
		w.Text = &Text
	case ContentBlockTypeImage:
		Data := b.Data
		w.Data = &Data
		MimeType := b.MimeType
		w.MimeType = &MimeType
	case ContentBlockTypeResource:
		URI := b.URI
		w.URI = &URI
	}
	return json.Marshal(w)
}

// UnmarshalJSON decodes the selected schema variant.
func (b *ContentBlock) UnmarshalJSON(data []byte) error {
	type alias ContentBlock
	var decoded alias
	var raw struct {
		Type     json.RawMessage `json:"type"`
		Data     json.RawMessage `json:"data"`
		MimeType json.RawMessage `json:"mimeType"`
		Text     json.RawMessage `json:"text"`
		Title    json.RawMessage `json:"title"`
		URI      json.RawMessage `json:"uri"`
	}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	var tag ContentBlockType
	var tagErr error
	if len(raw.Type) > 0 {
		tagErr = unmarshalJSON(raw.Type, &tag)
	}
	var err error
	switch tag {
	case "text":
		err = func() error {
			decoded = alias{}
			if tagErr != nil {
				return tagErr
			}
			decoded.Type = tag
			if err := requireJSONProperties(data, []string{"type", "text"}, []string{"text", "type"}); err != nil {
				return err
			}
			if len(raw.Text) > 0 {
				var value string
				if err := unmarshalJSON(raw.Text, &value); err != nil {
					return err
				}
				decoded.Text = value
			}
			return nil
		}()
	case "image":
		err = func() error {
			decoded = alias{}
			if tagErr != nil {
				return tagErr
			}
			decoded.Type = tag
			if err := requireJSONProperties(data, []string{"type", "data", "mimeType"}, []string{"data", "mimeType", "type"}); err != nil {
				return err
			}
			if len(raw.Data) > 0 {
				var value string
				if err := unmarshalJSON(raw.Data, &value); err != nil {
					return err
				}
				decoded.Data = value
			}
			if len(raw.MimeType) > 0 {
				var value string
				if err := unmarshalJSON(raw.MimeType, &value); err != nil {
					return err
				}
				decoded.MimeType = value
			}
			return nil
		}()
	case "resource":
		err = func() error {
			decoded = alias{}
			if tagErr != nil {
				return tagErr
			}
			decoded.Type = tag
			if err := requireJSONProperties(data, []string{"type", "uri"}, []string{"title", "type", "uri"}); err != nil {
				return err
			}
			if len(raw.Title) > 0 {
				var value string
				if err := unmarshalJSON(raw.Title, &value); err != nil {
					return err
				}
				decoded.Title = value
			}
			if len(raw.URI) > 0 {
				var value string
				if err := unmarshalJSON(raw.URI, &value); err != nil {
					return err
				}
				decoded.URI = value
			}
			return nil
		}()
	default:
		return fmt.Errorf("ContentBlock: unknown type %q", tag)
	}
	if err != nil {
		return err
	}
	*b = ContentBlock(decoded)
	return nil
}

// Message: A message containing content blocks.
type Message struct {
	Content []ContentBlock `json:"content"`
}

// MarshalJSON implements json.Marshaler.
func (m Message) MarshalJSON() ([]byte, error) {
	type alias Message
	a := alias(m)
	if a.Content == nil {
		a.Content = []ContentBlock{}
	}
	return json.Marshal(a)
}

// UnmarshalJSON implements json.Unmarshaler.
func (m *Message) UnmarshalJSON(data []byte) error {
	if err := requireJSONProperties(data, []string{"content"}, []string{"content"}); err != nil {
		return err
	}
	type alias Message
	decoded := alias{}
	raw := struct {
		*alias
	}{alias: &decoded}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	*m = Message(decoded)
	return nil
}
