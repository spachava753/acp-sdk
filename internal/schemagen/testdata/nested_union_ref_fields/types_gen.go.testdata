	if slices.Contains(r.requiredFields, "sessionId") {
		SessionID := r.SessionID
		w.SessionID = &SessionID
	}
	switch r.Mode {
	case CreatePromptRequestTypeForm:
		Schema := r.Schema
		w.Schema = &Schema
	case CreatePromptRequestTypeUrl:
