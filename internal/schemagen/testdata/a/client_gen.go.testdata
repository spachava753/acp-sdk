package acp

import (
	"context"
	"github.com/spachava753/acp-sdk/internal/jsonrpc2"
	"github.com/spachava753/acp-sdk/jsonrpc"
)

// GroupAgentMethod: Asks the agent to run the test agent method.
func (c *Client) GroupAgentMethod(ctx context.Context, params *AgentMethodRequest) (*AgentMethodResponse, error) {
	return call[AgentMethodResponse](ctx, c.rpc.conn, MethodGroupAgentMethod, params)
}

// GroupAgentNotify: Tells the agent about the test agent notification.
func (c *Client) GroupAgentNotify(ctx context.Context, params *AgentMethodNotification) error {
	return notify(ctx, c.rpc.conn, MethodGroupAgentNotify, params)
}

func handleClientRequest(ctx context.Context, handler any, req *jsonrpc.Request) (any, error) {
	jsonrpc2.Async(ctx)
	switch req.Method {
	case MethodGroupClientMethod:
		h, ok := handler.(GroupClientMethodHandler)
		if !ok {
			return nil, methodNotFound(req.Method)
		}
		params, err := decodeParams[ClientMethodRequest](req)
		if err != nil {
			return nil, err
		}
		return rpcResult(h.GroupClientMethod(ctx, params))
	case MethodGroupClientNotify:
		h, ok := handler.(GroupClientNotifyHandler)
		if !ok {
			return nil, methodNotFound(req.Method)
		}
		params, err := decodeParams[ClientMethodNotification](req)
		if err != nil {
			return nil, err
		}
		return nil, h.GroupClientNotify(ctx, params)
	default:
		return handleExtension(ctx, handler, req)
	}
}
