package acp

// Meta: Reserved metadata for protocol extensions. Decoded numbers are json.Number values.
type Meta map[string]any

// UnmarshalJSON preserves unstructured numbers as json.Number.
func (m *Meta) UnmarshalJSON(data []byte) error {
	type plain Meta
	return unmarshalJSON(data, (*plain)(m))
}

// AgentMethodNotification: Notification sent from the client to the agent.
type AgentMethodNotification struct {
	Meta      Meta      `json:"_meta,omitzero"`
	SessionID SessionId `json:"sessionId"`
}

// UnmarshalJSON implements json.Unmarshaler.
func (n *AgentMethodNotification) UnmarshalJSON(data []byte) error {
	if err := requireJSONProperties(data, []string{"sessionId"}, []string{"sessionId"}); err != nil {
		return err
	}
	type alias AgentMethodNotification
	decoded := alias{}
	raw := struct {
		*alias
	}{alias: &decoded}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	*n = AgentMethodNotification(decoded)
	return nil
}

