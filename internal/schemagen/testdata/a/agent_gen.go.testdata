package acp

import (
	"context"
	"github.com/spachava753/acp-sdk/jsonrpc"
)

// GroupClientMethod: Asks the client to run the test client method.
func (c *AgentConnection) GroupClientMethod(ctx context.Context, params *ClientMethodRequest) (*ClientMethodResponse, error) {
	return call[ClientMethodResponse](ctx, c.rpc.conn, MethodGroupClientMethod, params)
}

// GroupClientNotify: Tells the client about the test client notification.
func (c *AgentConnection) GroupClientNotify(ctx context.Context, params *ClientMethodNotification) error {
	return notify(ctx, c.rpc.conn, MethodGroupClientNotify, params)
}

func handleAgentRequest(ctx context.Context, handler any, req *jsonrpc.Request) (any, error) {
	beginHandler(ctx, req)
	switch req.Method {
	case MethodGroupAgentMethod:
		if !req.IsCall() {
			return nil, nil
		}
		h, ok := handler.(GroupAgentMethodHandler)
		if !ok {
			return nil, methodNotFound(req.Method)
		}
		params, err := decodeProtocolParams[AgentMethodRequest](req)
		if err != nil {
			return nil, err
		}
		return rpcResult(h.GroupAgentMethod(ctx, params))
	case MethodGroupAgentNotify:
		if req.IsCall() {
			return nil, methodNotFound(req.Method)
		}
		h, ok := handler.(GroupAgentNotifyHandler)
		if !ok {
			return nil, methodNotFound(req.Method)
		}
		params, err := decodeProtocolParams[AgentMethodNotification](req)
		if err != nil {
			return nil, err
		}
		return nil, h.GroupAgentNotify(ctx, params)
	default:
		return handleExtension(ctx, handler, req)
	}
}

func hasAgentInitializeHandler(handler any) bool {
	return false
}
