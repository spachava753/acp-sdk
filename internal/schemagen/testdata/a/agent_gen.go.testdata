package acp

const (
	// MethodGroupAgentMethod: Asks the agent to run the test agent method.
	MethodGroupAgentMethod = "group/agent_method"
	// MethodGroupAgentNotify: Tells the agent about the test agent notification.
	MethodGroupAgentNotify = "group/agent_notify"
	// MethodGroupClientMethod: Asks the client to run the test client method.
	MethodGroupClientMethod = "group/client_method"
	// MethodGroupClientNotify: Tells the client about the test client notification.
	MethodGroupClientNotify = "group/client_notify"
)

// GroupHandler handles all group related agent methods.
type GroupHandler interface {
	// AgentMethod: Asks the agent to run the test agent method.
	AgentMethod(context.Context, *AgentMethodRequest) (*AgentMethodResponse, error)

	// AgentNotify: Tells the agent about the test agent notification.
	AgentNotify(context.Context, *AgentMethodNotification) error
}

// ClientMethod: Asks the client to run the test client method.
func (c *AgentConnection) ClientMethod(ctx context.Context, params *ClientMethodRequest) (*ClientMethodResponse, error) {
	return call[ClientMethodResponse](ctx, c.rpc.conn, MethodGroupClientMethod, params)
}

// ClientNotify: Tells the client about the test client notification.
func (c *AgentConnection) ClientNotify(ctx context.Context, params *ClientMethodNotification) error {
	return notify(ctx, c.rpc.conn, MethodGroupClientNotify, params)
}

func handleAgentRequest(ctx context.Context, agent any, req *jsonrpc.Request) (any, error) {
	jsonrpc2.Async(ctx)
	if agent == nil {
		return nil, methodNotFound(req.Method)
	}
	switch req.Method {
	case MethodGroupAgentMethod:
		handler, ok := agent.(interface {
			AgentMethod(context.Context, *AgentMethodRequest) (*AgentMethodResponse, error)
		})
		if !ok {
			return nil, methodNotFound(req.Method)
		}
		params, err := decodeParams[AgentMethodRequest](req)
		if err != nil {
			return nil, err
		}
		return rpcResult(handler.AgentMethod(ctx, params))
	case MethodGroupAgentNotify:
		handler, ok := agent.(interface {
			AgentNotify(context.Context, *AgentMethodNotification) error
		})
		if !ok {
			return nil, methodNotFound(req.Method)
		}
		params, err := decodeParams[AgentMethodNotification](req)
		if err != nil {
			return nil, err
		}
		return nil, handler.AgentNotify(ctx, params)
	default:
		return nil, methodNotFound(req.Method)
	}
}
