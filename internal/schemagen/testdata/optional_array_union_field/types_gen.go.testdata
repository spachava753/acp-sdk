package acp

import (
	"encoding/json"
	"fmt"
	"reflect"
)

// ConfigOption: Config option with variant-only array-union payload.
type ConfigOption struct {
	Type    ConfigOptionType `json:"type"`
	Enabled bool             `json:"enabled,omitempty"`
	ID      string           `json:"id"`
	Options SelectOptions    `json:"options,omitempty,omitzero"`
}

// ConfigOptionType is the discriminator for ConfigOption variants.
type ConfigOptionType string

const (
	ConfigOptionTypeToggle ConfigOptionType = "toggle"
	ConfigOptionTypeSelect ConfigOptionType = "select"
)

// ToggleConfigOption creates toggle option.
func ToggleConfigOption(id string, enabled bool) ConfigOption {
	return ConfigOption{
		Type:    ConfigOptionTypeToggle,
		Enabled: enabled,
		ID:      id,
	}
}

// SelectConfigOption creates select option.
func SelectConfigOption(id string, options SelectOptions) ConfigOption {
	if options.Ungrouped == nil && options.Groups == nil {
		flat := UngroupedSelectOptions{}
		options = SelectOptions{Ungrouped: &flat}
	}
	return ConfigOption{
		Type:    ConfigOptionTypeSelect,
		ID:      id,
		Options: options,
	}
}

// MarshalJSON implements json.Marshaler.
func (o ConfigOption) MarshalJSON() ([]byte, error) {
	type alias ConfigOption
	type wire struct {
		*alias
		Enabled *bool          `json:"enabled,omitempty"`
		Options *SelectOptions `json:"options,omitempty"`
	}
	w := wire{alias: (*alias)(&o)}
	if !reflect.ValueOf(o.Enabled).IsZero() {
		Enabled := o.Enabled
		w.Enabled = &Enabled
	}
	if !reflect.ValueOf(o.Options).IsZero() {
		Options := o.Options
		w.Options = &Options
	}
	switch o.Type {
	case ConfigOptionTypeToggle:
		Enabled := o.Enabled
		w.Enabled = &Enabled
	case ConfigOptionTypeSelect:
		Options := o.Options
		if Options.Ungrouped == nil && Options.Groups == nil {
			flat := UngroupedSelectOptions{}
			Options = SelectOptions{Ungrouped: &flat}
		}
		w.Options = &Options
	}
	return json.Marshal(w)
}

// UnmarshalJSON decodes the selected schema variant.
func (o *ConfigOption) UnmarshalJSON(data []byte) error {
	type alias ConfigOption
	var decoded alias
	var raw struct {
		Type    json.RawMessage `json:"type"`
		Enabled json.RawMessage `json:"enabled"`
		ID      json.RawMessage `json:"id"`
		Options json.RawMessage `json:"options"`
	}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	var tag ConfigOptionType
	var tagErr error
	if len(raw.Type) > 0 {
		tagErr = unmarshalJSON(raw.Type, &tag)
	}
	var err error
	switch tag {
	case "toggle":
		err = func() error {
			decoded = alias{}
			if tagErr != nil {
				return tagErr
			}
			decoded.Type = tag
			if err := requireJSONProperties(data, []string{"id", "type", "enabled"}, []string{"enabled", "id", "type"}); err != nil {
				return err
			}
			if len(raw.Enabled) > 0 {
				var value bool
				if err := unmarshalJSON(raw.Enabled, &value); err != nil {
					return err
				}
				decoded.Enabled = value
			}
			if len(raw.ID) > 0 {
				var value string
				if err := unmarshalJSON(raw.ID, &value); err != nil {
					return err
				}
				decoded.ID = value
			}
			return nil
		}()
	case "select":
		err = func() error {
			decoded = alias{}
			if tagErr != nil {
				return tagErr
			}
			decoded.Type = tag
			if err := requireJSONProperties(data, []string{"id", "type", "options"}, []string{"id", "options", "type"}); err != nil {
				return err
			}
			if len(raw.ID) > 0 {
				var value string
				if err := unmarshalJSON(raw.ID, &value); err != nil {
					return err
				}
				decoded.ID = value
			}
			if len(raw.Options) > 0 {
				var value SelectOptions
				if err := unmarshalJSON(raw.Options, &value); err != nil {
					return err
				}
				decoded.Options = value
			}
			return nil
		}()
	default:
		return fmt.Errorf("ConfigOption: unknown type %q", tag)
	}
	if err != nil {
		return err
	}
	*o = ConfigOption(decoded)
	return nil
}

type SelectGroup struct {
	Name    string         `json:"name"`
	Options []SelectOption `json:"options"`
}

// MarshalJSON implements json.Marshaler.
func (g SelectGroup) MarshalJSON() ([]byte, error) {
	type alias SelectGroup
	a := alias(g)
	if a.Options == nil {
		a.Options = []SelectOption{}
	}
	return json.Marshal(a)
}

// UnmarshalJSON implements json.Unmarshaler.
func (g *SelectGroup) UnmarshalJSON(data []byte) error {
	if err := requireJSONProperties(data, []string{"name", "options"}, []string{"name", "options"}); err != nil {
		return err
	}
	type alias SelectGroup
	decoded := alias{}
	raw := struct {
		*alias
	}{alias: &decoded}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	*g = SelectGroup(decoded)
	return nil
}

type SelectOption struct {
	Value string `json:"value"`
}

// UnmarshalJSON implements json.Unmarshaler.
func (o *SelectOption) UnmarshalJSON(data []byte) error {
	if err := requireJSONProperties(data, []string{"value"}, []string{"value"}); err != nil {
		return err
	}
	type alias SelectOption
	decoded := alias{}
	raw := struct {
		*alias
	}{alias: &decoded}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	*o = SelectOption(decoded)
	return nil
}

// SelectOptions: Grouped or ungrouped select options.
type SelectOptions struct {
	Ungrouped *UngroupedSelectOptions
	Groups    *GroupedSelectOptions
}

// UngroupedSelectOptions is the ungrouped variant of SelectOptions.
type UngroupedSelectOptions []SelectOption

// GroupedSelectOptions is the grouped variant of SelectOptions.
type GroupedSelectOptions []SelectGroup

// MarshalJSON implements json.Marshaler.
func (o SelectOptions) MarshalJSON() ([]byte, error) {
	if o.Groups != nil {
		return json.Marshal(o.Groups)
	}
	if o.Ungrouped != nil {
		return json.Marshal(o.Ungrouped)
	}
	return []byte("null"), nil
}

// UnmarshalJSON implements json.Unmarshaler.
func (o *SelectOptions) UnmarshalJSON(data []byte) error {
	if string(data) == "null" {
		*o = SelectOptions{}
		return nil
	}
	var raw []json.RawMessage
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	if len(raw) == 0 {
		flat := UngroupedSelectOptions{}
		*o = SelectOptions{Ungrouped: &flat}
		return nil
	}
	var probe struct {
		Name string `json:"name"`
	}
	if err := unmarshalJSON(raw[0], &probe); err != nil {
		return err
	}
	if probe.Name != "" {
		var groups GroupedSelectOptions
		if err := unmarshalJSON(data, &groups); err != nil {
			return err
		}
		*o = SelectOptions{Groups: &groups}
		return nil
	}
	var flat UngroupedSelectOptions
	if err := unmarshalJSON(data, &flat); err != nil {
		return err
	}
	*o = SelectOptions{Ungrouped: &flat}
	return nil
}
