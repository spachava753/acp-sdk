package acp

import (
	"encoding/json"
	"fmt"
	"reflect"
)

// CollisionUnion: A discriminator union whose values normalize to the same Go suffix.
type CollisionUnion struct {
	Kind  CollisionUnionType `json:"kind"`
	Count int32              `json:"count,omitempty"`
	Ok    bool               `json:"ok,omitempty"`
	Text  string             `json:"text,omitempty"`
}

// CollisionUnionType is the discriminator for CollisionUnion variants.
type CollisionUnionType string

const (
	CollisionUnionTypeInProgress  CollisionUnionType = "in-progress"
	CollisionUnionTypeInProgress2 CollisionUnionType = "in_progress"
	CollisionUnionTypeInProgress3 CollisionUnionType = "in progress"
)

// InProgressCollisionUnion creates hyphen status.
func InProgressCollisionUnion(text string) CollisionUnion {
	return CollisionUnion{
		Kind: CollisionUnionTypeInProgress,
		Text: text,
	}
}

// InProgressCollisionUnion2 creates underscore status.
func InProgressCollisionUnion2(count int32) CollisionUnion {
	return CollisionUnion{
		Kind:  CollisionUnionTypeInProgress2,
		Count: count,
	}
}

// InProgressCollisionUnion3 creates spaced status.
func InProgressCollisionUnion3(ok bool) CollisionUnion {
	return CollisionUnion{
		Kind: CollisionUnionTypeInProgress3,
		Ok:   ok,
	}
}

// MarshalJSON implements json.Marshaler.
func (u CollisionUnion) MarshalJSON() ([]byte, error) {
	type alias CollisionUnion
	type wire struct {
		*alias
		Text  *string `json:"text,omitempty"`
		Count *int32  `json:"count,omitempty"`
		Ok    *bool   `json:"ok,omitempty"`
	}
	w := wire{alias: (*alias)(&u)}
	if !reflect.ValueOf(u.Text).IsZero() {
		Text := u.Text
		w.Text = &Text
	}
	if !reflect.ValueOf(u.Count).IsZero() {
		Count := u.Count
		w.Count = &Count
	}
	if !reflect.ValueOf(u.Ok).IsZero() {
		Ok := u.Ok
		w.Ok = &Ok
	}
	switch u.Kind {
	case CollisionUnionTypeInProgress:
		Text := u.Text
		w.Text = &Text
	case CollisionUnionTypeInProgress2:
		Count := u.Count
		w.Count = &Count
	case CollisionUnionTypeInProgress3:
		Ok := u.Ok
		w.Ok = &Ok
	}
	return json.Marshal(w)
}

// UnmarshalJSON decodes the selected schema variant.
func (u *CollisionUnion) UnmarshalJSON(data []byte) error {
	type alias CollisionUnion
	var decoded alias
	var raw struct {
		Kind  json.RawMessage `json:"kind"`
		Count json.RawMessage `json:"count"`
		Ok    json.RawMessage `json:"ok"`
		Text  json.RawMessage `json:"text"`
	}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	var tag CollisionUnionType
	var tagErr error
	if len(raw.Kind) > 0 {
		tagErr = unmarshalJSON(raw.Kind, &tag)
	}
	var err error
	switch tag {
	case "in-progress":
		err = func() error {
			decoded = alias{}
			if tagErr != nil {
				return tagErr
			}
			decoded.Kind = tag
			if err := requireJSONProperties(data, []string{"kind", "text"}, []string{"kind", "text"}); err != nil {
				return err
			}
			if len(raw.Text) > 0 {
				var value string
				if err := unmarshalJSON(raw.Text, &value); err != nil {
					return err
				}
				decoded.Text = value
			}
			return nil
		}()
	case "in_progress":
		err = func() error {
			decoded = alias{}
			if tagErr != nil {
				return tagErr
			}
			decoded.Kind = tag
			if err := requireJSONProperties(data, []string{"kind", "count"}, []string{"count", "kind"}); err != nil {
				return err
			}
			if len(raw.Count) > 0 {
				var value int32
				if err := unmarshalJSON(raw.Count, &value); err != nil {
					return err
				}
				decoded.Count = value
			}
			return nil
		}()
	case "in progress":
		err = func() error {
			decoded = alias{}
			if tagErr != nil {
				return tagErr
			}
			decoded.Kind = tag
			if err := requireJSONProperties(data, []string{"kind", "ok"}, []string{"kind", "ok"}); err != nil {
				return err
			}
			if len(raw.Ok) > 0 {
				var value bool
				if err := unmarshalJSON(raw.Ok, &value); err != nil {
					return err
				}
				decoded.Ok = value
			}
			return nil
		}()
	default:
		return fmt.Errorf("CollisionUnion: unknown kind %q", tag)
	}
	if err != nil {
		return err
	}
	*u = CollisionUnion(decoded)
	return nil
}

// Payload: Object with a tolerant array of colliding union items.
type Payload struct {
	Items []CollisionUnion `json:"items,omitempty"`
}

// UnmarshalJSON implements json.Unmarshaler.
func (p *Payload) UnmarshalJSON(data []byte) error {
	if err := requireJSONProperties(data, []string{}, []string{"items"}); err != nil {
		return err
	}
	type alias Payload
	decoded := alias{}
	raw := struct {
		Items json.RawMessage `json:"items"`
		*alias
	}{alias: &decoded}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	if len(raw.Items) > 0 {
		var values []json.RawMessage
		if err := unmarshalJSON(raw.Items, &values); err != nil {
			return err
		} else {
			decoded.Items = []CollisionUnion{}
			for _, value := range values {
				var item CollisionUnion
				if err := unmarshalJSON(value, &item); err == nil && !isJSONNull(value) {
					switch item.Kind {
					case CollisionUnionTypeInProgress, CollisionUnionTypeInProgress2, CollisionUnionTypeInProgress3:
						decoded.Items = append(decoded.Items, item)
					}
				}
			}
		}
	}
	*p = Payload(decoded)
	return nil
}
