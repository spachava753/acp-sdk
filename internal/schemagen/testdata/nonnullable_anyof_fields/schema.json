{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Non-nullable AnyOf Fields",
  "$defs": {
    "Choice": {
      "description": "Object with both nullable and non-nullable anyOf fields.",
      "type": "object",
      "properties": {
        "nullable": {
          "description": "Nullable string value.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "description": "Non-nullable scalar choice.",
          "anyOf": [
            {
              "title": "Text",
              "type": "string"
            },
            {
              "title": "Count",
              "type": "integer",
              "format": "int32"
            }
          ]
        }
      },
      "required": ["value"]
    }
  }
}
