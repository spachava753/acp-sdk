	}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	var tag ActionType
	var tagErr error
	if len(raw.Action) > 0 {
		tagErr = unmarshalJSON(raw.Action, &tag)
	}
	var err error
	switch tag {
	case "accept":
		err = func() error {
			decoded = alias{}
			if tagErr != nil {
				return tagErr
			}
			decoded.Action = tag
			if err := requireJSONProperties(data, []string{"action"}, []string{"action", "content"}); err != nil {
				return err
			}
			if len(raw.Meta) > 0 {
				var value Meta
				if err := unmarshalJSON(raw.Meta, &value); err == nil {
					decoded.Meta = value
				}
			}
			if len(raw.Content) > 0 {
				var value map[string]PrimitiveValue
				if err := func() error {
					if err := func(data []byte) error {
						return validateJSONMapValues(data, func(data []byte) error {
							return validateJSONUnion(data, validateJSONType[string], validateJSONNumber, validateJSONType[int64], validateJSONType[bool], func(data []byte) error {
								return validateJSONArrayValues(data, validateJSONType[string])
							})
						})
					}(raw.Content); err != nil {
						return err
					}
					return unmarshalJSON(raw.Content, &value)
				}(); err != nil {
					return err
				}
				decoded.Content = value
			}
			return nil
		}()
	default:
		err = func() error {
			decoded = alias{}
			if tagErr != nil {
				return tagErr
			}
			decoded.Action = tag
			if err := requireJSONProperties(data, []string{"action"}, []string{"action"}); err != nil {
				return err
			}
			if len(raw.Meta) > 0 {
				var value Meta
				if err := unmarshalJSON(raw.Meta, &value); err == nil {
					decoded.Meta = value
				}
			}
			extra, err := captureJSONExtraFields(data, []string{"_meta", "action"})
			if err != nil {
				return err
			}
			decoded.ExtraFields = extra
			return nil
		}()
	}
	if err != nil {
		return err
	}
	*a = Action(decoded)
	return nil
