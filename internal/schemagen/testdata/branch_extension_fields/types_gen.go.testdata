// Meta: Reserved metadata for protocol extensions. Decoded numbers are json.Number values.
type Meta map[string]any

// UnmarshalJSON preserves unstructured numbers as json.Number.
func (m *Meta) UnmarshalJSON(data []byte) error {
	type plain Meta
	return unmarshalJSON(data, (*plain)(m))
}

type Action struct {
	Action  ActionType                `json:"action"`
	Meta    Meta                      `json:"_meta,omitzero"`
	Content map[string]PrimitiveValue `json:"content,omitempty"`
	// ExtraFields retains extension properties explicitly permitted by the schema.
	// Known properties take precedence when encoding.
	ExtraFields map[string]json.RawMessage `json:"-"`
}

// ActionType is the discriminator for Action variants.
type ActionType string

const (
	ActionTypeAccept ActionType = "accept"
)

// AcceptAction creates .
func AcceptAction() Action {
	return Action{
		Action: ActionTypeAccept,
	}
}

// OtherAction creates .
func OtherAction(action string) Action {
	return Action{
		Action: ActionType(action),
	}
}

// MarshalJSON retains explicit extension fields for open variants.
func (a Action) MarshalJSON() ([]byte, error) {
	type alias Action
	switch a.Action {
	case "accept":
		return json.Marshal(alias(a))
	default:
		return marshalJSONWithExtraFields(alias(a), a.ExtraFields, []string{"_meta", "action"})
	}
}

// UnmarshalJSON decodes the selected schema variant.
func (a *Action) UnmarshalJSON(data []byte) error {
	type alias Action
	var decoded alias
	var raw struct {
		Action  json.RawMessage `json:"action"`
