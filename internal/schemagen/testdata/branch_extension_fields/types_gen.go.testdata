// StringItems creates .
func StringItems(values []string) Items {
	return Items{
		Kind:   ItemsTypeString,
		Values: values,
	}
}

// OtherItems creates .
func OtherItems(kind string) Items {
	return Items{
		Kind: ItemsType(kind),
	}
}

// TitledItems creates .
func TitledItems(anyOf []string) Items {
	return Items{
		AnyOf: anyOf,
	}
}

// MarshalJSON implements json.Marshaler.
func (i Items) MarshalJSON() ([]byte, error) {
	type alias Items
	type wire struct {
		*alias
		Values *[]string `json:"values,omitempty"`
		AnyOf  *[]string `json:"anyOf,omitempty"`
	}
	w := wire{alias: (*alias)(&i)}
	if len(i.Values) > 0 {
		Values := i.Values
		w.Values = &Values
	}
	if len(i.AnyOf) > 0 {
		AnyOf := i.AnyOf
		w.AnyOf = &AnyOf
	}
	switch i.Kind {
	case ItemsTypeString:
		Values := i.Values
		if Values == nil {
			Values = []string{}
		}
		w.Values = &Values
	case "":
		AnyOf := i.AnyOf
		if AnyOf == nil {
			AnyOf = []string{}
		}
		w.AnyOf = &AnyOf
	}
	switch i.Kind {
	case "string":
		return json.Marshal(w)
	default:
		return marshalJSONWithExtraFields(w, i.ExtraFields, []string{"kind"})
	}
}

