type ExtensibleError struct {
	Code         int32  `json:"code"`
	Data         any    `json:"data,omitempty"`
	ExtraFields2 string `json:"extraFields,omitempty"`
	Message      string `json:"message"`
	// NullFields lists JSON field names to send as explicit null, regardless of their values.
	// Decoding records explicit nulls here, separately from omitted fields.
	NullFields []string `json:"-"`
	// ExtraFields retains extension properties explicitly permitted by the schema.
	// Known properties take precedence when encoding.
	ExtraFields map[string]json.RawMessage `json:"-"`
}

// MarshalJSON implements json.Marshaler.
func (e ExtensibleError) MarshalJSON() ([]byte, error) {
	type alias ExtensibleError
	a := alias(e)
	type wire struct {
		*alias
		Data *any `json:"data,omitempty"`
	}
	w := wire{alias: &a}
	if a.Data != nil {
		Data := a.Data
		w.Data = &Data
	}
	if slices.Contains(a.NullFields, "data") {
		w.Data = new(any)
	}
	return marshalJSONWithExtraFields(w, a.ExtraFields, []string{"code", "data", "extraFields", "message"})
}

// UnmarshalJSON implements json.Unmarshaler.
func (e *ExtensibleError) UnmarshalJSON(data []byte) error {
	if err := requireJSONProperties(data, []string{"code", "message"}, []string{"code", "extraFields", "message"}); err != nil {
		return err
	}
	type alias ExtensibleError
	decoded := alias{}
	raw := struct {
		Data json.RawMessage `json:"data"`
		*alias
	}{alias: &decoded}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	if len(raw.Data) > 0 {
		if isJSONNull(raw.Data) {
			decoded.NullFields = append(decoded.NullFields, "data")
		} else {
			var value any
			if err := unmarshalJSON(raw.Data, &value); err != nil {
				return err
			}
			decoded.Data = value
		}
	}
	extra, err := captureJSONExtraFields(data, []string{"code", "data", "extraFields", "message"})
	if err != nil {
		return err
	}
	decoded.ExtraFields = extra
	*e = ExtensibleError(decoded)
	return nil
}

type Items struct {
