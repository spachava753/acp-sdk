{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "PrimitiveValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "integer",
          "format": "int64"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "ExtensibleError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "x-go-preserve-null": true
        },
        "extraFields": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": true
    },
    "Action": {
      "properties": {
        "_meta": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true,
          "x-deserialize-default-on-error": true
        }
      },
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "accept"
            },
            "content": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/PrimitiveValue"
              }
            }
          },
          "required": [
            "action"
          ]
        },
        {
          "title": "other",
          "type": "object",
          "properties": {
            "action": {
              "type": "string"
            }
          },
          "required": [
            "action"
          ],
          "not": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "const": "accept"
                  }
                },
                "required": [
                  "action"
                ]
              }
            ]
          },
          "additionalProperties": true
        }
      ]
    },
    "Items": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "string"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "kind",
            "values"
          ]
        },
        {
          "title": "other",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "not": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "string"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            ]
          },
          "additionalProperties": true
        },
        {
          "title": "titled",
          "type": "object",
          "properties": {
            "anyOf": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "anyOf"
          ]
        }
      ]
    }
  }
}
