package acp

import (
	"encoding/json"
	"fmt"
	"reflect"
)

// Meta: Reserved metadata for protocol extensions. Decoded numbers are json.Number values.
type Meta map[string]any

// UnmarshalJSON preserves unstructured numbers as json.Number.
func (m *Meta) UnmarshalJSON(data []byte) error {
	type plain Meta
	return unmarshalJSON(data, (*plain)(m))
}

// HybridOption: Flattened union with common parent option fields.
type HybridOption struct {
	Kind        HybridOptionType `json:"kind"`
	Meta        Meta             `json:"_meta,omitzero"`
	Category    string           `json:"category,omitempty"`
	Description *string          `json:"description,omitempty"`
	Enabled     bool             `json:"enabled,omitempty"`
	ID          string           `json:"id"`
	Name        string           `json:"name"`
	Text        string           `json:"text,omitempty"`
}

// HybridOptionType is the discriminator for HybridOption variants.
type HybridOptionType string

const (
	// HybridOptionTypeText: Text discriminator.
	HybridOptionTypeText HybridOptionType = "text"
	// HybridOptionTypeToggle: Toggle discriminator.
	HybridOptionTypeToggle HybridOptionType = "toggle"
)

// TextHybridOption creates text option.
func TextHybridOption(id string, name string, text string) HybridOption {
	return HybridOption{
		Kind: HybridOptionTypeText,
		ID:   id,
		Name: name,
		Text: text,
	}
}

// ToggleHybridOption creates toggle option.
func ToggleHybridOption(id string, name string, enabled bool) HybridOption {
	return HybridOption{
		Kind:    HybridOptionTypeToggle,
		Enabled: enabled,
		ID:      id,
		Name:    name,
	}
}

// MarshalJSON implements json.Marshaler.
func (o HybridOption) MarshalJSON() ([]byte, error) {
	type alias HybridOption
	type wire struct {
		*alias
		Text    *string `json:"text,omitempty"`
		Enabled *bool   `json:"enabled,omitempty"`
	}
	w := wire{alias: (*alias)(&o)}
	if !reflect.ValueOf(o.Text).IsZero() {
		Text := o.Text
		w.Text = &Text
	}
	if !reflect.ValueOf(o.Enabled).IsZero() {
		Enabled := o.Enabled
		w.Enabled = &Enabled
	}
	switch o.Kind {
	case HybridOptionTypeText:
		Text := o.Text
		w.Text = &Text
	case HybridOptionTypeToggle:
		Enabled := o.Enabled
		w.Enabled = &Enabled
	}
	return json.Marshal(w)
}

// UnmarshalJSON decodes the selected schema variant.
func (o *HybridOption) UnmarshalJSON(data []byte) error {
	type alias HybridOption
	var decoded alias
	var raw struct {
		Kind        json.RawMessage `json:"kind"`
		Meta        json.RawMessage `json:"_meta"`
		Category    json.RawMessage `json:"category"`
		Description json.RawMessage `json:"description"`
		Enabled     json.RawMessage `json:"enabled"`
		ID          json.RawMessage `json:"id"`
		Name        json.RawMessage `json:"name"`
		Text        json.RawMessage `json:"text"`
	}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	var tag HybridOptionType
	var tagErr error
	if len(raw.Kind) > 0 {
		tagErr = unmarshalJSON(raw.Kind, &tag)
	}
	var err error
	switch tag {
	case "text":
		err = func() error {
			decoded = alias{}
			if tagErr != nil {
				return tagErr
			}
			decoded.Kind = tag
			if err := requireJSONProperties(data, []string{"id", "name", "kind", "text"}, []string{"category", "id", "kind", "name", "text"}); err != nil {
				return err
			}
			if len(raw.Meta) > 0 {
				var value Meta
				if err := unmarshalJSON(raw.Meta, &value); err != nil {
					return err
				}
				decoded.Meta = value
			}
			if len(raw.Category) > 0 {
				var value string
				if err := unmarshalJSON(raw.Category, &value); err != nil {
					return err
				}
				decoded.Category = value
			}
			if len(raw.Description) > 0 {
				var value *string
				if err := unmarshalJSON(raw.Description, &value); err != nil {
					return err
				}
				decoded.Description = value
			}
			if len(raw.ID) > 0 {
				var value string
				if err := unmarshalJSON(raw.ID, &value); err != nil {
					return err
				}
				decoded.ID = value
			}
			if len(raw.Name) > 0 {
				var value string
				if err := unmarshalJSON(raw.Name, &value); err != nil {
					return err
				}
				decoded.Name = value
			}
			if len(raw.Text) > 0 {
				var value string
				if err := unmarshalJSON(raw.Text, &value); err != nil {
					return err
				}
				decoded.Text = value
			}
			return nil
		}()
	case "toggle":
		err = func() error {
			decoded = alias{}
			if tagErr != nil {
				return tagErr
			}
			decoded.Kind = tag
			if err := requireJSONProperties(data, []string{"id", "name", "kind", "enabled"}, []string{"category", "enabled", "id", "kind", "name"}); err != nil {
				return err
			}
			if len(raw.Meta) > 0 {
				var value Meta
				if err := unmarshalJSON(raw.Meta, &value); err != nil {
					return err
				}
				decoded.Meta = value
			}
			if len(raw.Category) > 0 {
				var value string
				if err := unmarshalJSON(raw.Category, &value); err != nil {
					return err
				}
				decoded.Category = value
			}
			if len(raw.Description) > 0 {
				var value *string
				if err := unmarshalJSON(raw.Description, &value); err != nil {
					return err
				}
				decoded.Description = value
			}
			if len(raw.Enabled) > 0 {
				var value bool
				if err := unmarshalJSON(raw.Enabled, &value); err != nil {
					return err
				}
				decoded.Enabled = value
			}
			if len(raw.ID) > 0 {
				var value string
				if err := unmarshalJSON(raw.ID, &value); err != nil {
					return err
				}
				decoded.ID = value
			}
			if len(raw.Name) > 0 {
				var value string
				if err := unmarshalJSON(raw.Name, &value); err != nil {
					return err
				}
				decoded.Name = value
			}
			return nil
		}()
	default:
		return fmt.Errorf("HybridOption: unknown kind %q", tag)
	}
	if err != nil {
		return err
	}
	*o = HybridOption(decoded)
	return nil
}

// HybridRequest: Flattened anyOf with common request identifiers.
type HybridRequest struct {
	Type      HybridRequestType `json:"type,omitempty"`
	ConfigID  string            `json:"configId"`
	SessionID string            `json:"sessionId"`
	Value     any               `json:"value"`
}

// HybridRequestType is the discriminator for HybridRequest variants.
type HybridRequestType string

const (
	// HybridRequestTypeBoolean: Boolean discriminator.
	HybridRequestTypeBoolean HybridRequestType = "boolean"
)

// BooleanHybridRequest creates boolean value.
func BooleanHybridRequest(sessionID string, configID string, value bool) HybridRequest {
	return HybridRequest{
		Type:      HybridRequestTypeBoolean,
		ConfigID:  configID,
		SessionID: sessionID,
		Value:     value,
	}
}

// ValueIdHybridRequest creates string value.
func ValueIdHybridRequest(sessionID string, configID string, value string) HybridRequest {
	return HybridRequest{
		ConfigID:  configID,
		SessionID: sessionID,
		Value:     value,
	}
}

