package acp

// MapContainer: Object containing nullable typed and arbitrary maps.
type MapContainer struct {
	Attributes *map[string]MapValue `json:"attributes"`
	Extensions map[string]any       `json:"extensions,omitempty"`
	Name       string               `json:"name"`
}

// UnmarshalJSON implements json.Unmarshaler.
func (c *MapContainer) UnmarshalJSON(data []byte) error {
	if err := requireJSONProperties(data, []string{"name", "attributes"}, []string{"name"}); err != nil {
		return err
	}
	type alias MapContainer
	decoded := alias{}
	raw := struct {
		*alias
	}{alias: &decoded}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	*c = MapContainer(decoded)
	return nil
}

// MapValue: Typed map value.
type MapValue struct {
	Value string `json:"value"`
}

// UnmarshalJSON implements json.Unmarshaler.
func (v *MapValue) UnmarshalJSON(data []byte) error {
	if err := requireJSONProperties(data, []string{"value"}, []string{"value"}); err != nil {
		return err
	}
	type alias MapValue
	decoded := alias{}
	raw := struct {
		*alias
	}{alias: &decoded}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	*v = MapValue(decoded)
	return nil
}
