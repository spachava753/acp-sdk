package acp

import "fmt"

// PromptOutcome: A simple object that uses enum definitions.
type PromptOutcome struct {
	Role       Role       `json:"role"`
	StopReason StopReason `json:"stopReason"`
}

// UnmarshalJSON implements json.Unmarshaler.
func (o *PromptOutcome) UnmarshalJSON(data []byte) error {
	if err := requireJSONProperties(data, []string{"role", "stopReason"}, []string{"role", "stopReason"}); err != nil {
		return err
	}
	type alias PromptOutcome
	decoded := alias{}
	raw := struct {
		*alias
	}{alias: &decoded}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	*o = PromptOutcome(decoded)
	return nil
}

// Role: The sender or recipient of messages and data in a conversation.
type Role string

const (
	RoleAssistant Role = "assistant"
	RoleUser      Role = "user"
)

// UnmarshalJSON rejects values outside the closed schema enum.
func (v *Role) UnmarshalJSON(data []byte) error {
	var value string
	if isJSONNull(data) {
		return fmt.Errorf("Role must not be null")
	}
	if err := unmarshalJSON(data, &value); err != nil {
		return err
	}
	switch value {
	case "assistant", "user":
		*v = Role(value)
		return nil
	}
	return fmt.Errorf("invalid Role value %q", value)
}

// StopReason: Reasons why an agent stops processing a prompt turn.
type StopReason string

const (
	// StopReasonEndTurn: The turn ended successfully.
	StopReasonEndTurn StopReason = "end_turn"
	// StopReasonMaxTokens: The turn ended because the agent reached the maximum number of tokens.
	StopReasonMaxTokens StopReason = "max_tokens"
	// StopReasonMaxTurnRequests: The turn ended because the agent reached the maximum number of allowed agent requests between user turns.
	StopReasonMaxTurnRequests StopReason = "max_turn_requests"
	// StopReasonRefusal: The turn ended because the agent refused to continue.
	StopReasonRefusal StopReason = "refusal"
	// StopReasonCancelled: The turn was cancelled by the client.
	StopReasonCancelled StopReason = "cancelled"
)

// UnmarshalJSON rejects values outside the closed schema enum.
func (v *StopReason) UnmarshalJSON(data []byte) error {
	var value string
	if isJSONNull(data) {
		return fmt.Errorf("StopReason must not be null")
	}
	if err := unmarshalJSON(data, &value); err != nil {
		return err
	}
	switch value {
	case "end_turn", "max_tokens", "max_turn_requests", "refusal", "cancelled":
		*v = StopReason(value)
		return nil
	}
	return fmt.Errorf("invalid StopReason value %q", value)
}
