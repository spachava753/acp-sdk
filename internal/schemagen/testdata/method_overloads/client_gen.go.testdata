package acp

import (
	"context"
	"github.com/spachava753/acp-sdk/internal/jsonrpc2"
	"github.com/spachava753/acp-sdk/jsonrpc"
)

// McpMessage: Asks the peer to process an MCP message.
func (c *Client) McpMessage(ctx context.Context, params *MessageMcpRequest) (*MessageMcpResponse, error) {
	return call[MessageMcpResponse](ctx, c.rpc.conn, MethodMcpMessage, params)
}

// McpMessageNotification: Sends an MCP-over-ACP notification.
func (c *Client) McpMessageNotification(ctx context.Context, params *MessageMcpNotification) error {
	return notify(ctx, c.rpc.conn, MethodMcpMessage, params)
}

func handleClientRequest(ctx context.Context, handler any, req *jsonrpc.Request) (any, error) {
	jsonrpc2.Async(ctx)
	switch req.Method {
	case MethodMcpMessage:
		if req.IsCall() {
			h, ok := handler.(McpMessageHandler)
			if !ok {
				return nil, methodNotFound(req.Method)
			}
			params, err := decodeParams[MessageMcpRequest](req)
			if err != nil {
				return nil, err
			}
			return rpcResult(h.McpMessage(ctx, params))
		}
		h, ok := handler.(McpMessageNotificationHandler)
		if !ok {
			return nil, methodNotFound(req.Method)
		}
		params, err := decodeParams[MessageMcpNotification](req)
		if err != nil {
			return nil, err
		}
		return nil, h.McpMessageNotification(ctx, params)
	default:
		return handleExtension(ctx, handler, req)
	}
}
