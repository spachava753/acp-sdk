package acp

// McpClientHandler handles all mcp related client methods.
type McpClientHandler interface {
	// Message: Asks the peer to process a message.
	Message(context.Context, *MessageRequest) (*MessageResponse, error)
}

// Message: Asks the peer to process a message.
func (c *Client) Message(ctx context.Context, params *MessageRequest) (*MessageResponse, error) {
	return call[MessageResponse](ctx, c.rpc.conn, MethodMcpMessage, params)
}

func (c *Client) handle(ctx context.Context, req *jsonrpc.Request) (any, error) {
	jsonrpc2.Async(ctx)
	if c.handler == nil {
		return nil, methodNotFound(req.Method)
	}
	switch req.Method {
	case MethodMcpMessage:
		handler, ok := c.handler.(interface {
			Message(context.Context, *MessageRequest) (*MessageResponse, error)
		})
		if !ok {
			return nil, methodNotFound(req.Method)
		}
		params, err := decodeParams[MessageRequest](req)
		if err != nil {
			return nil, err
		}
		return rpcResult(handler.Message(ctx, params))
	default:
		return nil, methodNotFound(req.Method)
	}
}
