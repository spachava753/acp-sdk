package acp

import (
	"context"
	"github.com/spachava753/acp-sdk/internal/jsonrpc2"
	"github.com/spachava753/acp-sdk/jsonrpc"
)

// McpMessage: Asks the peer to process a message.
func (c *AgentConnection) McpMessage(ctx context.Context, params *MessageRequest) (*MessageResponse, error) {
	return call[MessageResponse](ctx, c.rpc.conn, MethodMcpMessage, params)
}

func handleAgentRequest(ctx context.Context, handler any, req *jsonrpc.Request) (any, error) {
	jsonrpc2.Async(ctx)
	switch req.Method {
	case MethodMcpMessage:
		h, ok := handler.(McpMessageHandler)
		if !ok {
			return nil, methodNotFound(req.Method)
		}
		params, err := decodeParams[MessageRequest](req)
		if err != nil {
			return nil, err
		}
		return rpcResult(h.McpMessage(ctx, params))
	default:
		return handleExtension(ctx, handler, req)
	}
}
