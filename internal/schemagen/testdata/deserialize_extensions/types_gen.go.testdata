package acp

import (
	"encoding/json"
	"fmt"
	"reflect"
)

// Item: A referenced item.
type Item struct {
	ID string `json:"id"`
}

// UnmarshalJSON implements json.Unmarshaler.
func (i *Item) UnmarshalJSON(data []byte) error {
	if err := requireJSONProperties(data, []string{"id"}, []string{"id"}); err != nil {
		return err
	}
	type alias Item
	decoded := alias{}
	raw := struct {
		*alias
	}{alias: &decoded}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	*i = Item(decoded)
	return nil
}

// Payload: Object with tolerant deserialize fields.
type Payload struct {
	Items         []Item   `json:"items,omitempty"`
	Name          string   `json:"name,omitempty"`
	RequiredItems []string `json:"requiredItems"`
	Strict        string   `json:"strict"`
}

// MarshalJSON implements json.Marshaler.
func (p Payload) MarshalJSON() ([]byte, error) {
	type alias Payload
	a := alias(p)
	if a.RequiredItems == nil {
		a.RequiredItems = []string{}
	}
	return json.Marshal(a)
}

// UnmarshalJSON implements json.Unmarshaler.
func (p *Payload) UnmarshalJSON(data []byte) error {
	if err := requireJSONProperties(data, []string{"requiredItems", "strict"}, []string{"strict"}); err != nil {
		return err
	}
	type alias Payload
	decoded := alias{}
	raw := struct {
		Items         json.RawMessage `json:"items"`
		Name          json.RawMessage `json:"name"`
		RequiredItems json.RawMessage `json:"requiredItems"`
		*alias
	}{alias: &decoded}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	if len(raw.Items) > 0 {
		var values []json.RawMessage
		if err := unmarshalJSON(raw.Items, &values); err == nil {
			decoded.Items = []Item{}
			for _, value := range values {
				var item Item
				if err := unmarshalJSON(value, &item); err == nil && !isJSONNull(value) {
					decoded.Items = append(decoded.Items, item)
				}
			}
		}
	}
	if len(raw.Name) > 0 {
		var value string
		if err := unmarshalJSON(raw.Name, &value); err == nil {
			decoded.Name = value
		}
	}
	if len(raw.RequiredItems) > 0 {
		var values []json.RawMessage
		if err := unmarshalJSON(raw.RequiredItems, &values); err == nil {
			decoded.RequiredItems = []string{}
			for _, value := range values {
				var item string
				if err := unmarshalJSON(value, &item); err == nil && !isJSONNull(value) {
					decoded.RequiredItems = append(decoded.RequiredItems, item)
				}
			}
		}
	}
	*p = Payload(decoded)
	return nil
}

// Tagged: Flattened union with tolerant fields.
type Tagged struct {
	Kind   TaggedType `json:"kind"`
	Labels []string   `json:"labels,omitempty"`
	Title  string     `json:"title,omitempty"`
}

// TaggedType is the discriminator for Tagged variants.
type TaggedType string

const (
	TaggedTypeKnown TaggedType = "known"
	TaggedTypeOther TaggedType = "other"
)

// KnownTagged creates known branch.
func KnownTagged() Tagged {
	return Tagged{
		Kind: TaggedTypeKnown,
	}
}

// OtherTagged creates other branch.
func OtherTagged(title string) Tagged {
	return Tagged{
		Kind:  TaggedTypeOther,
		Title: title,
	}
}

// MarshalJSON implements json.Marshaler.
func (t Tagged) MarshalJSON() ([]byte, error) {
	type alias Tagged
	type wire struct {
		*alias
		Title *string `json:"title,omitempty"`
	}
	w := wire{alias: (*alias)(&t)}
	if !reflect.ValueOf(t.Title).IsZero() {
		Title := t.Title
		w.Title = &Title
	}
	switch t.Kind {
	case TaggedTypeOther:
		Title := t.Title
		w.Title = &Title
	}
	return json.Marshal(w)
}

// UnmarshalJSON decodes the selected schema variant.
func (t *Tagged) UnmarshalJSON(data []byte) error {
	type alias Tagged
	var decoded alias
	var raw struct {
		Kind   json.RawMessage `json:"kind"`
		Labels json.RawMessage `json:"labels"`
		Title  json.RawMessage `json:"title"`
	}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	var tag TaggedType
	var tagErr error
	if len(raw.Kind) > 0 {
		tagErr = unmarshalJSON(raw.Kind, &tag)
	}
	var err error
	switch tag {
	case "known":
		err = func() error {
			decoded = alias{}
			if tagErr != nil {
				return tagErr
			}
			decoded.Kind = tag
			if err := requireJSONProperties(data, []string{"kind"}, []string{"kind"}); err != nil {
				return err
			}
			if len(raw.Labels) > 0 {
				var values []json.RawMessage
				if err := unmarshalJSON(raw.Labels, &values); err == nil {
					items := []string{}
					for _, rawItem := range values {
						var item string
						if err := unmarshalJSON(rawItem, &item); err == nil && !isJSONNull(rawItem) {
							items = append(items, item)
						}
					}
					decoded.Labels = items
				}
			}
			return nil
		}()
	case "other":
		err = func() error {
			decoded = alias{}
			if tagErr != nil {
				return tagErr
			}
			decoded.Kind = tag
			if err := requireJSONProperties(data, []string{"kind", "title"}, []string{"kind"}); err != nil {
				return err
			}
			if len(raw.Title) > 0 {
				var value string
				if err := unmarshalJSON(raw.Title, &value); err == nil {
					decoded.Title = value
				}
			}
			return nil
		}()
	default:
		return fmt.Errorf("Tagged: unknown kind %q", tag)
	}
	if err != nil {
		return err
	}
	*t = Tagged(decoded)
	return nil
}
