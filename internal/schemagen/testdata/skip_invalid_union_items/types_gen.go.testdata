package acp

import (
	"encoding/json"
	"fmt"
	"reflect"
)

// FallbackItem: Tagged item with a default branch when type is absent.
type FallbackItem struct {
	Type FallbackItemType `json:"type,omitempty"`
	Path string           `json:"path,omitempty"`
	Url  string           `json:"url,omitempty"`
}

// FallbackItemType is the discriminator for FallbackItem variants.
type FallbackItemType string

const (
	FallbackItemTypeRemote FallbackItemType = "remote"
)

// RemoteFallbackItem creates remote item.
func RemoteFallbackItem(url string) FallbackItem {
	return FallbackItem{
		Type: FallbackItemTypeRemote,
		Url:  url,
	}
}

// LocalFallbackItem creates local item used when no type is present.
func LocalFallbackItem(path string) FallbackItem {
	return FallbackItem{
		Path: path,
	}
}

// MarshalJSON implements json.Marshaler.
func (i FallbackItem) MarshalJSON() ([]byte, error) {
	type alias FallbackItem
	type wire struct {
		*alias
		Url  *string `json:"url,omitempty"`
		Path *string `json:"path,omitempty"`
	}
	w := wire{alias: (*alias)(&i)}
	if !reflect.ValueOf(i.Url).IsZero() {
		Url := i.Url
		w.Url = &Url
	}
	if !reflect.ValueOf(i.Path).IsZero() {
		Path := i.Path
		w.Path = &Path
	}
	switch i.Type {
	case FallbackItemTypeRemote:
		Url := i.Url
		w.Url = &Url
	case "":
		Path := i.Path
		w.Path = &Path
	}
	return json.Marshal(w)
}

// UnmarshalJSON decodes the selected schema variant.
func (i *FallbackItem) UnmarshalJSON(data []byte) error {
	type alias FallbackItem
	var decoded alias
	var raw struct {
		Type json.RawMessage `json:"type"`
		Path json.RawMessage `json:"path"`
		Url  json.RawMessage `json:"url"`
	}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	var tag FallbackItemType
	var tagErr error
	if len(raw.Type) > 0 {
		tagErr = unmarshalJSON(raw.Type, &tag)
	}
	var err error
	switch tag {
	case "remote":
		err = func() error {
			decoded = alias{}
			if tagErr != nil {
				return tagErr
			}
			decoded.Type = tag
			if err := requireJSONProperties(data, []string{"type", "url"}, []string{"type", "url"}); err != nil {
				return err
			}
			if len(raw.Url) > 0 {
				var value string
				if err := unmarshalJSON(raw.Url, &value); err != nil {
					return err
				}
				decoded.Url = value
			}
			return nil
		}()
		if err != nil {
			err = func() error {
				decoded = alias{}
				if err := requireJSONProperties(data, []string{"path"}, []string{"path"}); err != nil {
					return err
				}
				if len(raw.Path) > 0 {
					var value string
					if err := unmarshalJSON(raw.Path, &value); err != nil {
						return err
					}
					decoded.Path = value
				}
				return nil
			}()
		}
	default:
		err = func() error {
			decoded = alias{}
			if err := requireJSONProperties(data, []string{"path"}, []string{"path"}); err != nil {
				return err
			}
			if len(raw.Path) > 0 {
				var value string
				if err := unmarshalJSON(raw.Path, &value); err != nil {
					return err
				}
				decoded.Path = value
			}
			return nil
		}()
	}
	if err != nil {
		return err
	}
	*i = FallbackItem(decoded)
	return nil
}

// Payload: Object with tolerant arrays of union items.
type Payload struct {
	FallbackItems []FallbackItem `json:"fallbackItems,omitempty"`
	Items         []TaggedItem   `json:"items,omitempty"`
}

// UnmarshalJSON implements json.Unmarshaler.
func (p *Payload) UnmarshalJSON(data []byte) error {
	type alias Payload
	decoded := alias{}
	raw := struct {
		FallbackItems json.RawMessage `json:"fallbackItems"`
		Items         json.RawMessage `json:"items"`
		*alias
	}{alias: &decoded}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	if len(raw.FallbackItems) > 0 {
		var values []json.RawMessage
		if err := unmarshalJSON(raw.FallbackItems, &values); err == nil {
			decoded.FallbackItems = []FallbackItem{}
			for _, value := range values {
				var item FallbackItem
				if err := unmarshalJSON(value, &item); err == nil {
					decoded.FallbackItems = append(decoded.FallbackItems, item)
				}
			}
		}
	}
	if len(raw.Items) > 0 {
		var values []json.RawMessage
		if err := unmarshalJSON(raw.Items, &values); err == nil {
			decoded.Items = []TaggedItem{}
			for _, value := range values {
				var item TaggedItem
				if err := unmarshalJSON(value, &item); err == nil {
					switch item.Kind {
					case TaggedItemTypeText, TaggedItemTypeImage:
						decoded.Items = append(decoded.Items, item)
					}
				}
			}
		}
	}
	*p = Payload(decoded)
	return nil
}

// TaggedItem: Tagged item with closed discriminator values.
type TaggedItem struct {
	Kind TaggedItemType `json:"kind"`
	Text string         `json:"text,omitempty"`
	URI  string         `json:"uri,omitempty"`
}

// TaggedItemType is the discriminator for TaggedItem variants.
type TaggedItemType string

const (
	TaggedItemTypeText  TaggedItemType = "text"
	TaggedItemTypeImage TaggedItemType = "image"
)

// TextTaggedItem creates text item.
func TextTaggedItem(text string) TaggedItem {
	return TaggedItem{
		Kind: TaggedItemTypeText,
		Text: text,
	}
}

// ImageTaggedItem creates image item.
func ImageTaggedItem(uri string) TaggedItem {
	return TaggedItem{
		Kind: TaggedItemTypeImage,
		URI:  uri,
	}
}

// MarshalJSON implements json.Marshaler.
func (i TaggedItem) MarshalJSON() ([]byte, error) {
	type alias TaggedItem
	type wire struct {
		*alias
		Text *string `json:"text,omitempty"`
		URI  *string `json:"uri,omitempty"`
	}
	w := wire{alias: (*alias)(&i)}
	if !reflect.ValueOf(i.Text).IsZero() {
		Text := i.Text
		w.Text = &Text
	}
	if !reflect.ValueOf(i.URI).IsZero() {
		URI := i.URI
		w.URI = &URI
	}
	switch i.Kind {
	case TaggedItemTypeText:
		Text := i.Text
		w.Text = &Text
	case TaggedItemTypeImage:
		URI := i.URI
		w.URI = &URI
	}
	return json.Marshal(w)
}

// UnmarshalJSON decodes the selected schema variant.
func (i *TaggedItem) UnmarshalJSON(data []byte) error {
	type alias TaggedItem
	var decoded alias
	var raw struct {
		Kind json.RawMessage `json:"kind"`
		Text json.RawMessage `json:"text"`
		URI  json.RawMessage `json:"uri"`
	}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	var tag TaggedItemType
	var tagErr error
	if len(raw.Kind) > 0 {
		tagErr = unmarshalJSON(raw.Kind, &tag)
	}
	var err error
	switch tag {
	case "text":
		err = func() error {
			decoded = alias{}
			if tagErr != nil {
				return tagErr
			}
			decoded.Kind = tag
			if err := requireJSONProperties(data, []string{"kind", "text"}, []string{"kind", "text"}); err != nil {
				return err
			}
			if len(raw.Text) > 0 {
				var value string
				if err := unmarshalJSON(raw.Text, &value); err != nil {
					return err
				}
				decoded.Text = value
			}
			return nil
		}()
	case "image":
		err = func() error {
			decoded = alias{}
			if tagErr != nil {
				return tagErr
			}
			decoded.Kind = tag
			if err := requireJSONProperties(data, []string{"kind", "uri"}, []string{"kind", "uri"}); err != nil {
				return err
			}
			if len(raw.URI) > 0 {
				var value string
				if err := unmarshalJSON(raw.URI, &value); err != nil {
					return err
				}
				decoded.URI = value
			}
			return nil
		}()
	default:
		return fmt.Errorf("TaggedItem: unknown kind %q", tag)
	}
	if err != nil {
		return err
	}
	*i = TaggedItem(decoded)
	return nil
}
