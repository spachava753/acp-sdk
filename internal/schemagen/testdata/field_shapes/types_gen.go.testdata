package acp

import "encoding/json"

// FieldShape: Object covering required, optional, nullable, defaulted, and required array fields.
type FieldShape struct {
	Enabled          bool      `json:"enabled,omitempty"`
	Items            []Item    `json:"items"`
	Label            string    `json:"label,omitempty"`
	Metadata         *Metadata `json:"metadata,omitempty"`
	Mode             string    `json:"mode,omitempty"`
	Name             string    `json:"name"`
	NullableAlias    *string   `json:"nullableAlias,omitempty"`
	NullableMetadata *Metadata `json:"nullableMetadata,omitempty"`
	Retries          int64     `json:"retries,omitempty"`
	Tags             []string  `json:"tags"`
}

// Item: A referenced item.
type Item struct {
	ID string `json:"id"`
}

// UnmarshalJSON implements json.Unmarshaler.
func (i *Item) UnmarshalJSON(data []byte) error {
	if err := requireJSONProperties(data, []string{"id"}, []string{"id"}); err != nil {
		return err
	}
	type alias Item
	decoded := alias{}
	raw := struct {
		*alias
	}{alias: &decoded}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	*i = Item(decoded)
	return nil
}

// Metadata: Metadata for the field shape.
type Metadata struct {
	Note string `json:"note,omitempty"`
}

// UnmarshalJSON implements json.Unmarshaler.
func (m *Metadata) UnmarshalJSON(data []byte) error {
	if err := requireJSONProperties(data, []string{}, []string{"note"}); err != nil {
		return err
	}
	type alias Metadata
	decoded := alias{}
	raw := struct {
		*alias
	}{alias: &decoded}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	*m = Metadata(decoded)
	return nil
}

// MarshalJSON implements json.Marshaler.
func (s FieldShape) MarshalJSON() ([]byte, error) {
	type alias FieldShape
	a := alias(s)
	if a.Items == nil {
		a.Items = []Item{}
	}
	if a.Tags == nil {
		a.Tags = []string{}
	}
	return json.Marshal(a)
}

// UnmarshalJSON implements json.Unmarshaler.
func (s *FieldShape) UnmarshalJSON(data []byte) error {
	if err := requireJSONProperties(data, []string{"name", "tags", "items"}, []string{"enabled", "items", "label", "metadata", "mode", "name", "retries", "tags"}); err != nil {
		return err
	}
	type alias FieldShape
	decoded := alias{}
	raw := struct {
		*alias
	}{alias: &decoded}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	*s = FieldShape(decoded)
	return nil
}
