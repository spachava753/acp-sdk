package acp

import "fmt"

// EmptyConstEnum: String constants including the empty string.
type EmptyConstEnum string

const (
	// EmptyConstEnumEmpty: No status was provided.
	EmptyConstEnumEmpty EmptyConstEnum = ""
	// EmptyConstEnumActive: The status is active.
	EmptyConstEnumActive EmptyConstEnum = "active"
)

// UnmarshalJSON rejects values outside the closed schema enum.
func (v *EmptyConstEnum) UnmarshalJSON(data []byte) error {
	var value string
	if isJSONNull(data) {
		return fmt.Errorf("EmptyConstEnum must not be null")
	}
	if err := unmarshalJSON(data, &value); err != nil {
		return err
	}
	switch value {
	case "", "active":
		*v = EmptyConstEnum(value)
		return nil
	}
	return fmt.Errorf("invalid EmptyConstEnum value %q", value)
}

// EmptyEnum: String enum including the empty string.
type EmptyEnum string

const (
	EmptyEnumEmpty EmptyEnum = ""
	EmptyEnumReady EmptyEnum = "ready"
)

// UnmarshalJSON rejects values outside the closed schema enum.
func (v *EmptyEnum) UnmarshalJSON(data []byte) error {
	var value string
	if isJSONNull(data) {
		return fmt.Errorf("EmptyEnum must not be null")
	}
	if err := unmarshalJSON(data, &value); err != nil {
		return err
	}
	switch value {
	case "", "ready":
		*v = EmptyEnum(value)
		return nil
	}
	return fmt.Errorf("invalid EmptyEnum value %q", value)
}

// OpenStatus: Open string constants including the empty string.
type OpenStatus string

const (
	// OpenStatusEmpty: No explicit status.
	OpenStatusEmpty OpenStatus = ""
	// OpenStatusInProgress: Work is in progress.
	OpenStatusInProgress OpenStatus = "in-progress"
)
