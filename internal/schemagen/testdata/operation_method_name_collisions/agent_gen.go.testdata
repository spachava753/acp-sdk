package acp

import (
	"context"
	"github.com/spachava753/acp-sdk/internal/jsonrpc2"
	"github.com/spachava753/acp-sdk/jsonrpc"
)

func (c *AgentConnection) ChatSendMessage(ctx context.Context, params *SendMessageRequest) (*SendMessageResponse, error) {
	return call[SendMessageResponse](ctx, c.rpc.conn, MethodChatSendMessage, params)
}

func (c *AgentConnection) ChatSendMessage2(ctx context.Context, params *SendMessageAltRequest) (*SendMessageAltResponse, error) {
	return call[SendMessageAltResponse](ctx, c.rpc.conn, MethodChatSendMessage2, params)
}

func handleAgentRequest(ctx context.Context, handler any, req *jsonrpc.Request) (any, error) {
	jsonrpc2.Async(ctx)
	switch req.Method {
	case MethodChatSendMessage:
		h, ok := handler.(ChatSendMessageHandler)
		if !ok {
			return nil, methodNotFound(req.Method)
		}
		params, err := decodeParams[SendMessageRequest](req)
		if err != nil {
			return nil, err
		}
		return rpcResult(h.ChatSendMessage(ctx, params))
	case MethodChatSendMessage2:
		h, ok := handler.(ChatSendMessage2Handler)
		if !ok {
			return nil, methodNotFound(req.Method)
		}
		params, err := decodeParams[SendMessageAltRequest](req)
		if err != nil {
			return nil, err
		}
		return rpcResult(h.ChatSendMessage2(ctx, params))
	default:
		return handleExtension(ctx, handler, req)
	}
}
