// UnmarshalJSON implements json.Unmarshaler.
func (b *TextBranch) UnmarshalJSON(data []byte) error {
	if err := requireJSONProperties(data, []string{"text"}, []string{"text"}); err != nil {
		return err
	}
	type alias TextBranch
	decoded := alias{}
	raw := struct {
		*alias
	}{alias: &decoded}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	*b = TextBranch(decoded)
	return nil
}
