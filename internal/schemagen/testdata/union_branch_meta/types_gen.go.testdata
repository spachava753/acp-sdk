package acp

import (
	"encoding/json"
	"fmt"
	"reflect"
)

// Meta: Reserved metadata for protocol extensions. Decoded numbers are json.Number values.
type Meta map[string]any

// UnmarshalJSON preserves unstructured numbers as json.Number.
func (m *Meta) UnmarshalJSON(data []byte) error {
	type plain Meta
	return unmarshalJSON(data, (*plain)(m))
}

// BranchMetaUnion: Flattened union whose variants inherit _meta from referenced objects.
type BranchMetaUnion struct {
	Kind BranchMetaUnionType `json:"kind"`
	Meta Meta                `json:"_meta,omitzero"`
	Text string              `json:"text,omitempty"`
	URI  string              `json:"uri,omitempty"`
}

// BranchMetaUnionType is the discriminator for BranchMetaUnion variants.
type BranchMetaUnionType string

const (
	BranchMetaUnionTypeText BranchMetaUnionType = "text"
	BranchMetaUnionTypeLink BranchMetaUnionType = "link"
)

// TextBranchMetaUnion creates an BranchMetaUnion variant: Text variant.
func TextBranchMetaUnion(text string) BranchMetaUnion {
	return BranchMetaUnion{
		Kind: BranchMetaUnionTypeText,
		Text: text,
	}
}

// LinkBranchMetaUnion creates an BranchMetaUnion variant: Link variant.
func LinkBranchMetaUnion(uri string) BranchMetaUnion {
	return BranchMetaUnion{
		Kind: BranchMetaUnionTypeLink,
		URI:  uri,
	}
}

// MarshalJSON implements json.Marshaler.
func (u BranchMetaUnion) MarshalJSON() ([]byte, error) {
	type alias BranchMetaUnion
	type wire struct {
		*alias
		Text *string `json:"text,omitempty"`
		URI  *string `json:"uri,omitempty"`
	}
	w := wire{alias: (*alias)(&u)}
	if !reflect.ValueOf(u.Text).IsZero() {
		Text := u.Text
		w.Text = &Text
	}
	if !reflect.ValueOf(u.URI).IsZero() {
		URI := u.URI
		w.URI = &URI
	}
	switch u.Kind {
	case BranchMetaUnionTypeText:
		Text := u.Text
		w.Text = &Text
	case BranchMetaUnionTypeLink:
		URI := u.URI
		w.URI = &URI
	}
	return json.Marshal(w)
}

// UnmarshalJSON decodes the selected schema variant.
func (u *BranchMetaUnion) UnmarshalJSON(data []byte) error {
	type alias BranchMetaUnion
	var decoded alias
	var raw struct {
		Kind json.RawMessage `json:"kind"`
		Meta json.RawMessage `json:"_meta"`
		Text json.RawMessage `json:"text"`
		URI  json.RawMessage `json:"uri"`
	}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	var tag BranchMetaUnionType
	var tagErr error
	if len(raw.Kind) > 0 {
		tagErr = unmarshalJSON(raw.Kind, &tag)
	}
	var err error
	switch tag {
	case "text":
		err = func() error {
			decoded = alias{}
			if tagErr != nil {
				return tagErr
			}
			decoded.Kind = tag
			if err := requireJSONProperties(data, []string{"kind", "text"}, []string{"kind", "text"}); err != nil {
				return err
			}
			if len(raw.Meta) > 0 {
				var value Meta
				if err := unmarshalJSON(raw.Meta, &value); err != nil {
					return err
				}
				decoded.Meta = value
			}
			if len(raw.Text) > 0 {
				var value string
				if err := unmarshalJSON(raw.Text, &value); err != nil {
					return err
				}
				decoded.Text = value
			}
			return nil
		}()
	case "link":
		err = func() error {
			decoded = alias{}
			if tagErr != nil {
				return tagErr
			}
			decoded.Kind = tag
			if err := requireJSONProperties(data, []string{"kind", "uri"}, []string{"kind", "uri"}); err != nil {
				return err
			}
			if len(raw.Meta) > 0 {
				var value Meta
				if err := unmarshalJSON(raw.Meta, &value); err != nil {
					return err
				}
				decoded.Meta = value
			}
			if len(raw.URI) > 0 {
				var value string
				if err := unmarshalJSON(raw.URI, &value); err != nil {
					return err
				}
				decoded.URI = value
			}
			return nil
		}()
	default:
		return fmt.Errorf("BranchMetaUnion: unknown kind %q", tag)
	}
	if err != nil {
		return err
	}
	*u = BranchMetaUnion(decoded)
	return nil
}

// LinkBranch: Link branch payload.
type LinkBranch struct {
	Meta Meta   `json:"_meta,omitzero"`
	URI  string `json:"uri"`
}

// UnmarshalJSON implements json.Unmarshaler.
func (b *LinkBranch) UnmarshalJSON(data []byte) error {
	if err := requireJSONProperties(data, []string{"uri"}, []string{"uri"}); err != nil {
		return err
	}
	type alias LinkBranch
	decoded := alias{}
	raw := struct {
		*alias
	}{alias: &decoded}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	*b = LinkBranch(decoded)
	return nil
}

// TextBranch: Text branch payload.
type TextBranch struct {
	Meta Meta   `json:"_meta,omitzero"`
	Text string `json:"text"`
