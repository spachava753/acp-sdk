{
  "$defs": {
    "AliasA": {
      "description": "First named string alias.",
      "type": "string"
    },
    "AliasB": {
      "description": "Second named string alias.",
      "type": "string"
    },
    "AuthMethod": {
      "anyOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/AuthMethodEnvVar"
            }
          ],
          "description": "The client passes an environment variable to the agent.",
          "properties": {
            "type": {
              "const": "env_var",
              "description": "Environment variable authentication discriminator.",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/AuthMethodTerminal"
            }
          ],
          "description": "The client runs an interactive terminal for authentication.",
          "properties": {
            "type": {
              "const": "terminal",
              "description": "Terminal authentication discriminator.",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/AuthMethodAgent"
            }
          ],
          "description": "The agent handles authentication when no type discriminator is present.",
          "title": "agent"
        }
      ],
      "description": "Authentication method union with a default variant."
    },
    "AuthMethodAgent": {
      "description": "Agent-managed authentication method.",
      "properties": {
        "id": {
          "description": "Authentication method identifier.",
          "type": "string"
        },
        "name": {
          "description": "Display name.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "AuthMethodEnvVar": {
      "description": "Environment variable authentication method.",
      "properties": {
        "envName": {
          "description": "Environment variable name.",
          "type": "string"
        },
        "id": {
          "description": "Authentication method identifier.",
          "type": "string"
        },
        "name": {
          "description": "Display name.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "envName"
      ],
      "type": "object"
    },
    "AuthMethodTerminal": {
      "description": "Terminal authentication method.",
      "properties": {
        "command": {
          "description": "Command to run.",
          "type": "string"
        },
        "id": {
          "description": "Authentication method identifier.",
          "type": "string"
        },
        "name": {
          "description": "Display name.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "command"
      ],
      "type": "object"
    },
    "Collision": {
      "anyOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/SpecialCollision"
            }
          ],
          "description": "Collision variant branch.",
          "title": "Special"
        }
      ],
      "description": "Union whose constructor name would collide with a referenced variant type."
    },
    "ElicitationContentValue": {
      "anyOf": [
        {
          "title": "String",
          "type": "string"
        },
        {
          "title": "Integer",
          "type": "integer"
        },
        {
          "title": "Number",
          "type": "number"
        },
        {
          "title": "Boolean",
          "type": "boolean"
        },
        {
          "items": {
            "type": "string"
          },
          "title": "StringArray",
          "type": "array"
        }
      ],
      "description": "Primitive or string-array elicitation content."
    },
    "NestedObject": {
      "description": "Nested object that must disappear when its flattened union field is zero.",
      "properties": {
        "uri": {
          "description": "Nested URI.",
          "type": "string"
        }
      },
      "required": [
        "uri"
      ],
      "type": "object"
    },
    "ObjectFieldUnion": {
      "description": "Flattened union with an optional object-valued variant field.",
      "oneOf": [
        {
          "description": "Text branch.",
          "properties": {
            "items": {
              "description": "Required list that should marshal nil as an empty array.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "text": {
              "type": "string"
            },
            "type": {
              "const": "text",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text",
            "items"
          ],
          "title": "Text",
          "type": "object"
        },
        {
          "description": "Nested object branch.",
          "properties": {
            "nested": {
              "allOf": [
                {
                  "$ref": "#/$defs/NestedObject"
                }
              ]
            },
            "type": {
              "const": "nested",
              "type": "string"
            }
          },
          "required": [
            "type",
            "nested"
          ],
          "title": "Nested",
          "type": "object"
        }
      ]
    },
    "PlainLeft": {
      "description": "Left variant without a discriminator.",
      "properties": {
        "left": {
          "description": "Left value.",
          "type": "string"
        }
      },
      "required": [
        "left"
      ],
      "type": "object"
    },
    "PlainRight": {
      "description": "Right variant without a discriminator.",
      "properties": {
        "right": {
          "description": "Right value.",
          "type": "string"
        }
      },
      "required": [
        "right"
      ],
      "type": "object"
    },
    "PlainUnion": {
      "anyOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/PlainLeft"
            }
          ],
          "description": "Left branch.",
          "title": "Left"
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/PlainRight"
            }
          ],
          "description": "Right branch.",
          "title": "Right"
        }
      ],
      "description": "Titled referenced object union without a const discriminator."
    },
    "RequestId": {
      "anyOf": [
        {
          "title": "Null",
          "type": "null"
        },
        {
          "title": "Number",
          "type": "integer"
        },
        {
          "title": "String",
          "type": "string"
        }
      ],
      "description": "JSON-RPC request identifier."
    },
    "SelectGroup": {
      "description": "A grouped set of select options.",
      "properties": {
        "group": {
          "description": "Group label.",
          "type": "string"
        },
        "options": {
          "description": "Options in this group.",
          "items": {
            "$ref": "#/$defs/SelectOption"
          },
          "type": "array"
        }
      },
      "required": [
        "group",
        "options"
      ],
      "type": "object"
    },
    "SelectOption": {
      "description": "A selectable option.",
      "properties": {
        "label": {
          "description": "Display label.",
          "type": "string"
        },
        "value": {
          "description": "Option value.",
          "type": "string"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "type": "object"
    },
    "SelectOptions": {
      "anyOf": [
        {
          "description": "A flat list of options with no grouping.",
          "items": {
            "$ref": "#/$defs/SelectOption"
          },
          "title": "Flat",
          "type": "array"
        },
        {
          "description": "A list of options grouped under headers.",
          "items": {
            "$ref": "#/$defs/SelectGroup"
          },
          "title": "Grouped",
          "type": "array"
        }
      ],
      "description": "Select options represented by one of two array shapes."
    },
    "SharedFieldUnion": {
      "description": "Flattened union with repeated fields that use compatible aliases and incompatible primitive kinds.",
      "oneOf": [
        {
          "description": "Alias string branch.",
          "properties": {
            "kind": {
              "const": "alias_one",
              "type": "string"
            },
            "value": {
              "allOf": [
                {
                  "$ref": "#/$defs/AliasA"
                }
              ]
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "title": "AliasOne",
          "type": "object"
        },
        {
          "description": "Second alias string branch.",
          "properties": {
            "kind": {
              "const": "alias_two",
              "type": "string"
            },
            "value": {
              "allOf": [
                {
                  "$ref": "#/$defs/AliasB"
                }
              ]
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "title": "AliasTwo",
          "type": "object"
        },
        {
          "description": "Boolean branch sharing the same value field name.",
          "properties": {
            "kind": {
              "const": "boolean",
              "type": "string"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "title": "Boolean",
          "type": "object"
        }
      ]
    },
    "SpecialCollision": {
      "description": "Referenced variant whose name would collide with the generated constructor.",
      "properties": {
        "value": {
          "description": "Variant value.",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "type": "object"
    },
    "UnionContainer": {
      "description": "Object that references hard union shapes.",
      "properties": {
        "auth": {
          "allOf": [
            {
              "$ref": "#/$defs/AuthMethod"
            }
          ],
          "description": "Authentication method."
        },
        "collision": {
          "allOf": [
            {
              "$ref": "#/$defs/Collision"
            }
          ],
          "description": "Collision union."
        },
        "content": {
          "allOf": [
            {
              "$ref": "#/$defs/ElicitationContentValue"
            }
          ],
          "description": "Elicitation content value."
        },
        "objectField": {
          "allOf": [
            {
              "$ref": "#/$defs/ObjectFieldUnion"
            }
          ],
          "description": "Union with object field."
        },
        "plain": {
          "allOf": [
            {
              "$ref": "#/$defs/PlainUnion"
            }
          ],
          "description": "Plain union."
        },
        "requestId": {
          "allOf": [
            {
              "$ref": "#/$defs/RequestId"
            }
          ],
          "description": "Request identifier."
        },
        "selectOptions": {
          "allOf": [
            {
              "$ref": "#/$defs/SelectOptions"
            }
          ],
          "description": "Select options."
        },
        "shared": {
          "allOf": [
            {
              "$ref": "#/$defs/SharedFieldUnion"
            }
          ],
          "description": "Shared field union."
        }
      },
      "required": [
        "auth",
        "requestId",
        "selectOptions"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hard Union Test Fixture"
}
