func (m AuthMethod) MarshalJSON() ([]byte, error) {
	type alias AuthMethod
	type wire struct {
		*alias
		EnvName *string `json:"envName,omitempty"`
		Command *string `json:"command,omitempty"`
	}
	w := wire{alias: (*alias)(&m)}
	if !reflect.ValueOf(m.EnvName).IsZero() {
		EnvName := m.EnvName
		w.EnvName = &EnvName
	}
	if !reflect.ValueOf(m.Command).IsZero() {
		Command := m.Command
		w.Command = &Command
	}
	switch m.Type {
	case AuthMethodTypeEnvVar:
		EnvName := m.EnvName
		w.EnvName = &EnvName
	case AuthMethodTypeTerminal:
		Command := m.Command
		w.Command = &Command
	}
	return json.Marshal(w)
}

