	if !reflect.ValueOf(u.Nested).IsZero() {
		Nested := u.Nested
		w.Nested = &Nested
	}
	switch u.Type {
	case ObjectFieldUnionTypeText:
		Items := u.Items
		if Items == nil {
			Items = []string{}
		}
		w.Items = &Items
		Text := u.Text
		w.Text = &Text
	case ObjectFieldUnionTypeNested:
		Nested := u.Nested
		w.Nested = &Nested
