package acp

import (
	"encoding/json"
	"reflect"
)

// AliasA: First named string alias.
type AliasA string

// AliasB: Second named string alias.
type AliasB string

// AuthMethod: Authentication method union with a default variant.
type AuthMethod struct {
	Type    AuthMethodType `json:"type,omitempty"`
	Command string         `json:"command,omitempty"`
	EnvName string         `json:"envName,omitempty"`
	ID      string         `json:"id"`
	Name    string         `json:"name"`
}

// AuthMethodType is the discriminator for AuthMethod variants.
type AuthMethodType string

const (
	// AuthMethodTypeEnvVar: Environment variable authentication discriminator.
	AuthMethodTypeEnvVar AuthMethodType = "env_var"
	// AuthMethodTypeTerminal: Terminal authentication discriminator.
	AuthMethodTypeTerminal AuthMethodType = "terminal"
)

// EnvVarAuthMethod creates an AuthMethod variant: The client passes an environment variable to the agent.
func EnvVarAuthMethod(id string, name string, envName string) AuthMethod {
	return AuthMethod{
		Type:    AuthMethodTypeEnvVar,
		EnvName: envName,
		ID:      id,
		Name:    name,
	}
}

// TerminalAuthMethod creates an AuthMethod variant: The client runs an interactive terminal for authentication.
func TerminalAuthMethod(id string, name string, command string) AuthMethod {
	return AuthMethod{
		Type:    AuthMethodTypeTerminal,
		Command: command,
		ID:      id,
		Name:    name,
	}
}

// AgentAuthMethod creates an AuthMethod variant: The agent handles authentication when no type discriminator is present.
func AgentAuthMethod(id string, name string) AuthMethod {
	return AuthMethod{
		ID:   id,
		Name: name,
	}
}

// MarshalJSON implements json.Marshaler.
func (m AuthMethod) MarshalJSON() ([]byte, error) {
	type alias AuthMethod
	type wire struct {
		*alias
		EnvName *string `json:"envName,omitempty"`
		Command *string `json:"command,omitempty"`
	}
	w := wire{alias: (*alias)(&m)}
	if !reflect.ValueOf(m.EnvName).IsZero() {
		EnvName := m.EnvName
		w.EnvName = &EnvName
	}
	if !reflect.ValueOf(m.Command).IsZero() {
		Command := m.Command
		w.Command = &Command
	}
	switch m.Type {
	case AuthMethodTypeEnvVar:
		EnvName := m.EnvName
		w.EnvName = &EnvName
	case AuthMethodTypeTerminal:
		Command := m.Command
		w.Command = &Command
	}
	return json.Marshal(w)
}

// AuthMethodAgent: Agent-managed authentication method.
type AuthMethodAgent struct {
	ID   string `json:"id"`
	Name string `json:"name"`
}

// AuthMethodEnvVar: Environment variable authentication method.
type AuthMethodEnvVar struct {
	EnvName string `json:"envName"`
	ID      string `json:"id"`
	Name    string `json:"name"`
}

// AuthMethodTerminal: Terminal authentication method.
type AuthMethodTerminal struct {
	Command string `json:"command"`
	ID      string `json:"id"`
	Name    string `json:"name"`
}

// Collision: Union whose constructor name would collide with a referenced variant type.
type Collision struct {
	Value string `json:"value"`
}

// NewSpecialCollision creates an Collision variant: Collision variant branch.
func NewSpecialCollision(value string) Collision {
	return Collision{
		Value: value,
	}
}

// ElicitationContentValue: Primitive or string-array elicitation content.
type ElicitationContentValue = json.RawMessage

// NestedObject: Nested object that must disappear when its flattened union field is zero.
type NestedObject struct {
	URI string `json:"uri"`
}

// ObjectFieldUnion: Flattened union with an optional object-valued variant field.
type ObjectFieldUnion struct {
	Type   ObjectFieldUnionType `json:"type"`
	Items  []string             `json:"items,omitempty"`
	Nested NestedObject         `json:"nested,omitempty,omitzero"`
	Text   string               `json:"text,omitempty"`
}

// ObjectFieldUnionType is the discriminator for ObjectFieldUnion variants.
type ObjectFieldUnionType string

const (
	ObjectFieldUnionTypeText   ObjectFieldUnionType = "text"
	ObjectFieldUnionTypeNested ObjectFieldUnionType = "nested"
)

// TextObjectFieldUnion creates text branch.
func TextObjectFieldUnion(text string, items []string) ObjectFieldUnion {
	return ObjectFieldUnion{
		Type:  ObjectFieldUnionTypeText,
		Items: items,
		Text:  text,
	}
}

// NestedObjectFieldUnion creates nested object branch.
func NestedObjectFieldUnion(nested NestedObject) ObjectFieldUnion {
	return ObjectFieldUnion{
		Type:   ObjectFieldUnionTypeNested,
		Nested: nested,
	}
}

// MarshalJSON implements json.Marshaler.
func (u ObjectFieldUnion) MarshalJSON() ([]byte, error) {
	type alias ObjectFieldUnion
	type wire struct {
		*alias
		Items  *[]string     `json:"items,omitempty"`
		Text   *string       `json:"text,omitempty"`
		Nested *NestedObject `json:"nested,omitempty"`
	}
	w := wire{alias: (*alias)(&u)}
	if len(u.Items) > 0 {
		Items := u.Items
		w.Items = &Items
	}
	if !reflect.ValueOf(u.Text).IsZero() {
		Text := u.Text
		w.Text = &Text
	}
	if !reflect.ValueOf(u.Nested).IsZero() {
		Nested := u.Nested
		w.Nested = &Nested
	}
	switch u.Type {
	case ObjectFieldUnionTypeText:
		Items := u.Items
		if Items == nil {
			Items = []string{}
		}
		w.Items = &Items
		Text := u.Text
		w.Text = &Text
	case ObjectFieldUnionTypeNested:
		Nested := u.Nested
		w.Nested = &Nested
	}
	return json.Marshal(w)
}

// PlainLeft: Left variant without a discriminator.
type PlainLeft struct {
	Left string `json:"left"`
}

// PlainRight: Right variant without a discriminator.
type PlainRight struct {
	Right string `json:"right"`
}

// PlainUnion: Titled referenced object union without a const discriminator.
type PlainUnion struct {
	Left  string `json:"left,omitempty"`
	Right string `json:"right,omitempty"`
}

// LeftPlainUnion creates an PlainUnion variant: Left branch.
func LeftPlainUnion(left string) PlainUnion {
	return PlainUnion{
		Left: left,
	}
}

// RightPlainUnion creates an PlainUnion variant: Right branch.
func RightPlainUnion(right string) PlainUnion {
	return PlainUnion{
		Right: right,
	}
}

// RequestId: JSON-RPC request identifier.
type RequestId = json.RawMessage

// SelectGroup: A grouped set of select options.
type SelectGroup struct {
	Group   string         `json:"group"`
	Options []SelectOption `json:"options"`
}

// MarshalJSON implements json.Marshaler.
func (g SelectGroup) MarshalJSON() ([]byte, error) {
	type alias SelectGroup
	a := alias(g)
	if a.Options == nil {
		a.Options = []SelectOption{}
	}
	return json.Marshal(a)
}

// SelectOption: A selectable option.
type SelectOption struct {
	Label string `json:"label"`
	Value string `json:"value"`
}

// SelectOptions: Select options represented by one of two array shapes.
type SelectOptions struct {
	Flat   *FlatSelectOptions
	Groups *GroupedSelectOptions
}

// FlatSelectOptions is the flat variant of SelectOptions.
type FlatSelectOptions []SelectOption

// GroupedSelectOptions is the grouped variant of SelectOptions.
type GroupedSelectOptions []SelectGroup

// MarshalJSON implements json.Marshaler.
func (o SelectOptions) MarshalJSON() ([]byte, error) {
	if o.Groups != nil {
		return json.Marshal(o.Groups)
	}
	if o.Flat != nil {
		return json.Marshal(o.Flat)
	}
	return []byte("null"), nil
}

// UnmarshalJSON implements json.Unmarshaler.
func (o *SelectOptions) UnmarshalJSON(data []byte) error {
	if string(data) == "null" {
		*o = SelectOptions{}
		return nil
	}
	var raw []json.RawMessage
	if err := json.Unmarshal(data, &raw); err != nil {
		return err
	}
	if len(raw) == 0 {
		flat := FlatSelectOptions{}
		*o = SelectOptions{Flat: &flat}
		return nil
	}
	var probe struct {
		Group string `json:"group"`
	}
	if err := json.Unmarshal(raw[0], &probe); err != nil {
		return err
	}
	if probe.Group != "" {
		var groups GroupedSelectOptions
		if err := json.Unmarshal(data, &groups); err != nil {
			return err
		}
		*o = SelectOptions{Groups: &groups}
		return nil
	}
	var flat FlatSelectOptions
	if err := json.Unmarshal(data, &flat); err != nil {
		return err
	}
	*o = SelectOptions{Flat: &flat}
	return nil
}

// SharedFieldUnion: Flattened union with repeated fields that use compatible aliases and incompatible primitive kinds.
type SharedFieldUnion struct {
	Kind  SharedFieldUnionType `json:"kind"`
	Value any                  `json:"value"`
}

// SharedFieldUnionType is the discriminator for SharedFieldUnion variants.
type SharedFieldUnionType string

const (
	SharedFieldUnionTypeAliasOne SharedFieldUnionType = "alias_one"
	SharedFieldUnionTypeAliasTwo SharedFieldUnionType = "alias_two"
	SharedFieldUnionTypeBoolean  SharedFieldUnionType = "boolean"
)

// AliasOneSharedFieldUnion creates alias string branch.
func AliasOneSharedFieldUnion(value AliasA) SharedFieldUnion {
	return SharedFieldUnion{
		Kind:  SharedFieldUnionTypeAliasOne,
		Value: value,
	}
}

// AliasTwoSharedFieldUnion creates second alias string branch.
func AliasTwoSharedFieldUnion(value AliasB) SharedFieldUnion {
	return SharedFieldUnion{
		Kind:  SharedFieldUnionTypeAliasTwo,
		Value: value,
	}
}

// BooleanSharedFieldUnion creates boolean branch sharing the same value field name.
func BooleanSharedFieldUnion(value bool) SharedFieldUnion {
	return SharedFieldUnion{
		Kind:  SharedFieldUnionTypeBoolean,
		Value: value,
	}
}

// SpecialCollision: Referenced variant whose name would collide with the generated constructor.
type SpecialCollision struct {
	Value string `json:"value"`
}

// UnionContainer: Object that references hard union shapes.
type UnionContainer struct {
	Auth          AuthMethod              `json:"auth"`
	Collision     *Collision              `json:"collision,omitempty"`
	Content       ElicitationContentValue `json:"content,omitempty"`
	ObjectField   *ObjectFieldUnion       `json:"objectField,omitempty"`
	Plain         *PlainUnion             `json:"plain,omitempty"`
	RequestID     RequestId               `json:"requestId"`
	SelectOptions SelectOptions           `json:"selectOptions"`
	Shared        *SharedFieldUnion       `json:"shared,omitempty"`
}
