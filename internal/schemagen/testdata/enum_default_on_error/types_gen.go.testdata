package acp

import (
	"encoding/json"
	"fmt"
)

// Payload: Object with tolerant enum fields.
type Payload struct {
	Role         Role    `json:"role,omitempty"`
	Status       *Status `json:"status,omitempty"`
	StrictStatus Status  `json:"strictStatus"`
}

// UnmarshalJSON implements json.Unmarshaler.
func (p *Payload) UnmarshalJSON(data []byte) error {
	if err := requireJSONProperties(data, []string{"strictStatus"}, []string{"strictStatus"}); err != nil {
		return err
	}
	type alias Payload
	decoded := alias{}
	raw := struct {
		Role   json.RawMessage `json:"role"`
		Status json.RawMessage `json:"status"`
		*alias
	}{alias: &decoded}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	if len(raw.Role) > 0 {
		var value Role
		if err := unmarshalJSON(raw.Role, &value); err == nil {
			switch string(value) {
			case "assistant", "user":
				decoded.Role = value
			}
		}
	}
	if len(raw.Status) > 0 {
		var value Status
		if err := unmarshalJSON(raw.Status, &value); err == nil {
			switch string(value) {
			case "queued", "running":
				decoded.Status = &value
			}
		}
	}
	*p = Payload(decoded)
	return nil
}

// Role: Known participant roles.
type Role string

const (
	RoleAssistant Role = "assistant"
	RoleUser      Role = "user"
)

// UnmarshalJSON rejects values outside the closed schema enum.
func (v *Role) UnmarshalJSON(data []byte) error {
	var value string
	if isJSONNull(data) {
		return fmt.Errorf("Role must not be null")
	}
	if err := unmarshalJSON(data, &value); err != nil {
		return err
	}
	switch value {
	case "assistant", "user":
		*v = Role(value)
		return nil
	}
	return fmt.Errorf("invalid Role value %q", value)
}

// Status: Known status values.
type Status string

const (
	// StatusQueued: The item is queued.
	StatusQueued Status = "queued"
	// StatusRunning: The item is running.
	StatusRunning Status = "running"
)

// UnmarshalJSON rejects values outside the closed schema enum.
func (v *Status) UnmarshalJSON(data []byte) error {
	var value string
	if isJSONNull(data) {
		return fmt.Errorf("Status must not be null")
	}
	if err := unmarshalJSON(data, &value); err != nil {
		return err
	}
	switch value {
	case "queued", "running":
		*v = Status(value)
		return nil
	}
	return fmt.Errorf("invalid Status value %q", value)
}
