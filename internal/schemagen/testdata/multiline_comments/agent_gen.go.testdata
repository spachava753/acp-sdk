package acp

import (
	"context"
	"github.com/spachava753/acp-sdk/jsonrpc"
)

func handleAgentRequest(ctx context.Context, handler any, req *jsonrpc.Request) (any, error) {
	beginHandler(ctx, req)
	switch req.Method {
	case MethodDocsGenerate:
		if !req.IsCall() {
			return nil, nil
		}
		h, ok := handler.(DocsGenerateHandler)
		if !ok {
			return nil, methodNotFound(req.Method)
		}
		params, err := decodeProtocolParams[GenerateDocsRequest](req)
		if err != nil {
			return nil, err
		}
		return rpcResult(h.DocsGenerate(ctx, params))
	default:
		return handleExtension(ctx, handler, req)
	}
}

func hasAgentInitializeHandler(handler any) bool {
	return false
}
