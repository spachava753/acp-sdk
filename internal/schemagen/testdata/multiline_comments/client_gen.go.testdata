package acp

import (
	"context"
	"github.com/spachava753/acp-sdk/internal/jsonrpc2"
	"github.com/spachava753/acp-sdk/jsonrpc"
)

// DocsGenerate: Generates documentation from structured input.
//
// The agent should preserve Markdown formatting.
//
// - Validate the title
// - Render the body
func (c *Client) DocsGenerate(ctx context.Context, params *GenerateDocsRequest) (*GenerateDocsResponse, error) {
	return call[GenerateDocsResponse](ctx, c.rpc.conn, MethodDocsGenerate, params)
}

func handleClientRequest(ctx context.Context, handler any, req *jsonrpc.Request) (any, error) {
	jsonrpc2.Async(ctx)
	switch req.Method {
	default:
		return handleExtension(ctx, handler, req)
	}
}
