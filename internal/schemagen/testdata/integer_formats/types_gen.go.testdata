package acp

// Counters: Object covering formatted integer fields.
type Counters struct {
	ErrorCode ErrorCode `json:"errorCode"`
	Line      uint32    `json:"line"`
	Plain     int64     `json:"plain"`
	Port      uint16    `json:"port"`
	Sequence  int64     `json:"sequence"`
	Tokens    uint64    `json:"tokens"`
}

// UnmarshalJSON implements json.Unmarshaler.
func (c *Counters) UnmarshalJSON(data []byte) error {
	if err := requireJSONProperties(data, []string{"errorCode", "line", "plain", "port", "sequence", "tokens"}, []string{"errorCode", "line", "plain", "port", "sequence", "tokens"}); err != nil {
		return err
	}
	type alias Counters
	decoded := alias{}
	raw := struct {
		*alias
	}{alias: &decoded}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	*c = Counters(decoded)
	return nil
}

// ErrorCode: Known int32 error codes with room for custom values.
type ErrorCode int32

const (
	// ErrorCodeInvalidRequest: The request is invalid.
	ErrorCodeInvalidRequest ErrorCode = -32600
)
