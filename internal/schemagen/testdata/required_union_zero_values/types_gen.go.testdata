package acp

import (
	"encoding/json"
	"fmt"
	"reflect"
)

// Choice: Tagged union with branch-required zero-value fields.
type Choice struct {
	Type    ChoiceType `json:"type"`
	Count   int64      `json:"count,omitempty"`
	Enabled bool       `json:"enabled,omitempty"`
	Payload Payload    `json:"payload,omitzero"`
	Text    string     `json:"text,omitempty"`
}

// ChoiceType is the discriminator for Choice variants.
type ChoiceType string

const (
	ChoiceTypeText    ChoiceType = "text"
	ChoiceTypeCount   ChoiceType = "count"
	ChoiceTypePayload ChoiceType = "payload"
)

// TextChoice creates text branch with required scalar fields.
func TextChoice(enabled bool, text string) Choice {
	return Choice{
		Type:    ChoiceTypeText,
		Enabled: enabled,
		Text:    text,
	}
}

// CountChoice creates count branch with a required integer field.
func CountChoice(count int64) Choice {
	return Choice{
		Type:  ChoiceTypeCount,
		Count: count,
	}
}

// PayloadChoice creates payload branch with a required object field.
func PayloadChoice(payload Payload) Choice {
	return Choice{
		Type:    ChoiceTypePayload,
		Payload: payload,
	}
}

// MarshalJSON implements json.Marshaler.
func (c Choice) MarshalJSON() ([]byte, error) {
	type alias Choice
	type wire struct {
		*alias
		Enabled *bool    `json:"enabled,omitempty"`
		Text    *string  `json:"text,omitempty"`
		Count   *int64   `json:"count,omitempty"`
		Payload *Payload `json:"payload,omitempty"`
	}
	w := wire{alias: (*alias)(&c)}
	if !reflect.ValueOf(c.Enabled).IsZero() {
		Enabled := c.Enabled
		w.Enabled = &Enabled
	}
	if !reflect.ValueOf(c.Text).IsZero() {
		Text := c.Text
		w.Text = &Text
	}
	if !reflect.ValueOf(c.Count).IsZero() {
		Count := c.Count
		w.Count = &Count
	}
	if !reflect.ValueOf(c.Payload).IsZero() {
		Payload := c.Payload
		w.Payload = &Payload
	}
	switch c.Type {
	case ChoiceTypeText:
		Enabled := c.Enabled
		w.Enabled = &Enabled
		Text := c.Text
		w.Text = &Text
	case ChoiceTypeCount:
		Count := c.Count
		w.Count = &Count
	case ChoiceTypePayload:
		Payload := c.Payload
		w.Payload = &Payload
	}
	return json.Marshal(w)
}

// UnmarshalJSON decodes the selected schema variant.
func (c *Choice) UnmarshalJSON(data []byte) error {
	type alias Choice
	var decoded alias
	var raw struct {
		Type    json.RawMessage `json:"type"`
		Count   json.RawMessage `json:"count"`
		Enabled json.RawMessage `json:"enabled"`
		Payload json.RawMessage `json:"payload"`
		Text    json.RawMessage `json:"text"`
	}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	var tag ChoiceType
	var tagErr error
	if len(raw.Type) > 0 {
		tagErr = unmarshalJSON(raw.Type, &tag)
	}
	var err error
	switch tag {
	case "text":
		err = func() error {
			decoded = alias{}
			if tagErr != nil {
				return tagErr
			}
			decoded.Type = tag
			if err := requireJSONProperties(data, []string{"type", "enabled", "text"}, []string{"enabled", "text", "type"}); err != nil {
				return err
			}
			if len(raw.Enabled) > 0 {
				var value bool
				if err := unmarshalJSON(raw.Enabled, &value); err != nil {
					return err
				}
				decoded.Enabled = value
			}
			if len(raw.Text) > 0 {
				var value string
				if err := unmarshalJSON(raw.Text, &value); err != nil {
					return err
				}
				decoded.Text = value
			}
			return nil
		}()
	case "count":
		err = func() error {
			decoded = alias{}
			if tagErr != nil {
				return tagErr
			}
			decoded.Type = tag
			if err := requireJSONProperties(data, []string{"type", "count"}, []string{"count", "type"}); err != nil {
				return err
			}
			if len(raw.Count) > 0 {
				var value int64
				if err := unmarshalJSON(raw.Count, &value); err != nil {
					return err
				}
				decoded.Count = value
			}
			return nil
		}()
	case "payload":
		err = func() error {
			decoded = alias{}
			if tagErr != nil {
				return tagErr
			}
			decoded.Type = tag
			if err := requireJSONProperties(data, []string{"type", "payload"}, []string{"payload", "type"}); err != nil {
				return err
			}
			if len(raw.Payload) > 0 {
				var value Payload
				if err := unmarshalJSON(raw.Payload, &value); err != nil {
					return err
				}
				decoded.Payload = value
			}
			return nil
		}()
	default:
		return fmt.Errorf("Choice: unknown type %q", tag)
	}
	if err != nil {
		return err
	}
	*c = Choice(decoded)
	return nil
}

// Payload: Payload object.
type Payload struct {
	ID string `json:"id"`
}

// UnmarshalJSON implements json.Unmarshaler.
func (p *Payload) UnmarshalJSON(data []byte) error {
	if err := requireJSONProperties(data, []string{"id"}, []string{"id"}); err != nil {
		return err
	}
	type alias Payload
	decoded := alias{}
	raw := struct {
		*alias
	}{alias: &decoded}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	*p = Payload(decoded)
	return nil
}
