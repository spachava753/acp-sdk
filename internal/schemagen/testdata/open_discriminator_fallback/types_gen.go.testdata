package acp

import (
	"encoding/json"
	"reflect"
)

// OpenAction: Tagged union with an open fallback discriminator branch.
type OpenAction struct {
	Action OpenActionType `json:"action"`
	Value  string         `json:"value,omitempty"`
}

// OpenActionType is the discriminator for OpenAction variants.
type OpenActionType string

const (
	OpenActionTypeAccept OpenActionType = "accept"
)

// AcceptOpenAction creates known accept action.
func AcceptOpenAction(value string) OpenAction {
	return OpenAction{
		Action: OpenActionTypeAccept,
		Value:  value,
	}
}

// OtherOpenAction creates custom action value.
func OtherOpenAction(action string) OpenAction {
	return OpenAction{
		Action: OpenActionType(action),
	}
}

// MarshalJSON implements json.Marshaler.
func (a OpenAction) MarshalJSON() ([]byte, error) {
	type alias OpenAction
	type wire struct {
		*alias
		Value *string `json:"value,omitempty"`
	}
	w := wire{alias: (*alias)(&a)}
	if !reflect.ValueOf(a.Value).IsZero() {
		Value := a.Value
		w.Value = &Value
	}
	switch a.Action {
	case OpenActionTypeAccept:
		Value := a.Value
		w.Value = &Value
	}
	return json.Marshal(w)
}

// UnmarshalJSON decodes the selected schema variant.
func (a *OpenAction) UnmarshalJSON(data []byte) error {
	type alias OpenAction
	var decoded alias
	var raw struct {
		Action json.RawMessage `json:"action"`
		Value  json.RawMessage `json:"value"`
	}
	if err := unmarshalJSON(data, &raw); err != nil {
		return err
	}
	var tag OpenActionType
	var tagErr error
	if len(raw.Action) > 0 {
		tagErr = unmarshalJSON(raw.Action, &tag)
	}
	var err error
	switch tag {
	case "accept":
		err = func() error {
			decoded = alias{}
			if tagErr != nil {
				return tagErr
			}
			decoded.Action = tag
			if err := requireJSONProperties(data, []string{"action", "value"}, []string{"action", "value"}); err != nil {
				return err
			}
			if len(raw.Value) > 0 {
				var value string
				if err := unmarshalJSON(raw.Value, &value); err != nil {
					return err
				}
				decoded.Value = value
			}
			return nil
		}()
		if err != nil {
			err = func() error {
				decoded = alias{}
				if tagErr != nil {
					return tagErr
				}
				decoded.Action = tag
				if err := requireJSONProperties(data, []string{"action"}, []string{"action"}); err != nil {
					return err
				}
				return nil
			}()
		}
	default:
		err = func() error {
			decoded = alias{}
			if tagErr != nil {
				return tagErr
			}
			decoded.Action = tag
			if err := requireJSONProperties(data, []string{"action"}, []string{"action"}); err != nil {
				return err
			}
			return nil
		}()
	}
	if err != nil {
		return err
	}
	*a = OpenAction(decoded)
	return nil
}
