{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open Discriminator Fallback Fixture",
  "$defs": {
    "OpenAction": {
      "description": "Tagged union with an open fallback discriminator branch.",
      "anyOf": [
        {
          "description": "Known accept action.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "accept"
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["action", "value"]
        },
        {
          "title": "other",
          "description": "Custom action value.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string"
            }
          },
          "required": ["action"]
        }
      ],
      "discriminator": {
        "propertyName": "action"
      }
    }
  }
}
